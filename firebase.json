{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/inzsh{,/**}",
        "destination": "https://inzsh.abdellahaddoun.com/",
        "type": 301
      },
      {
        "source": "/joeinz-ds{,/**}",
        "destination": "https://joeinz-ds.abdellahaddoun.com/",
        "type": 301
      }
    ]
  }
}
