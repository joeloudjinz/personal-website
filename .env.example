# Environment variables

# Firebase configuration
ApiKey=
AuthDomain=
ProjectId=
StorageBucket=
MessagingSenderId=
AppId=
MeasurementId=

# Environment variables

# Google Analytics Measurement ID (for Google Analytics 4) - must use PUBLIC_ prefix for client access
PUBLIC_GTAG_MEASUREMENT_ID=G-XXXXXXXXXX

# Subdomain deploy tooling (scripts/subdomain) — the site builds fine without these

# Cloudflare: dashboard -> My Profile -> API Tokens
# Permission required: Account -> Cloudflare Pages -> Edit
CLOUDFLARE_API_TOKEN=
# dashboard -> Workers & Pages -> Account ID (right-hand pane)
CLOUDFLARE_ACCOUNT_ID=

# Porkbun: https://porkbun.com/account/api
# Generating a key is not enough. API access must ALSO be switched on per-domain
# in Porkbun's domain management, or every call fails authentication.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=