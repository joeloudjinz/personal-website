---
// Dispatcher for project showcase pages. Two templates render them: the band
// template (inzsh) in BandPage, and the pinboard template (joeinz-ds) in
// PinboardPage. getStaticPaths stays here because this file is the route.
import BandPage from '@src/components/projectpage/BandPage.astro';
import PinboardPage from '@src/components/projectpage/PinboardPage.astro';
import {getProjectPages, isPinboard, type BandEntry, type PinboardEntry} from '@src/utils/projectPages';

export async function getStaticPaths() {
    // getProjectPages() fails the build if a slug collides with a blog post or a
    // top-level page — this route is the only thing that puts them in one namespace.
    const pages = await getProjectPages();
    return pages.map((page) => ({params: {project: page.data.slug}, props: {page}}));
}

// The union of the two templates rather than the collection entry type, whose
// `data` is one object holding a union: isPinboard() cannot narrow that in the
// false branch, and BandPage only accepts a band entry.
interface Props {
    page: PinboardEntry | BandEntry;
}

const {page} = Astro.props;
---
{isPinboard(page) ? <PinboardPage page={page}/> : <BandPage page={page}/>}
