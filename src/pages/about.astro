---
// Header image temporarily removed; a new one will replace it
// import {Image} from 'astro:assets';
// import Avatar from '@src/assets/img/ava-wide.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import EducationCard from '../components/EducationCard.astro';
import ContactBlock from '../components/ContactBlock.astro';
// import {FULL_NAME} from '../consts';
import {getCollection} from 'astro:content';
import {getExperiences} from '../utils/experiences';

// Newest first: the current role leads the timeline, expanded
const experiences = (await getExperiences()).reverse();
const education = (await getCollection('education')).sort(
    (a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime()
);
---

<BaseLayout title='About Abdellah Addoun'
            description='Read and discover more about the next senior software engineer in your team, or the next team-player in your company.'
            gradient='subtle'>
    <!-- Header -->
    <section class='shell pt-16 pb-14'>
        <div class='cascade'>
            <p class='kicker mb-5'>About · The person behind @joeinz</p>
            <h1 class='font-display text-4xl md:text-[56px] font-semibold text-strong tracking-[-0.015em] leading-tight mb-6'>
                The <span class='marker-wash'>person</span> behind <span class='marker-wash whitespace-nowrap'>the commits</span>.
            </h1>
            <p class='text-[21px] text-muted leading-relaxed max-w-[760px] mb-10'>
                At my core, I'm a problem-solver. I thrive on untangling complex challenges by leading projects and
                building software with the resources at hand. For me, technology isn't just about code; it's about
                crafting smart, effective solutions that make a real difference.
            </p>
            {/* <Image src={Avatar} alt={FULL_NAME} class='w-full h-[240px] md:h-[360px] object-cover rounded-tile shadow-card'/> */}
        </div>
    </section>

    <!-- Experience timeline -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px]' id='experienceSection'>
            <p class='kicker mb-4'>
                <span class='cue-back'>Today → 2019</span><span class='cue-forward'>2019 → Today</span> · {experiences.length} roles
            </p>
            <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight mb-12'>
                The story behind my experience.
            </h2>
            <div class='relative' id='experienceTimeline'>
                <div id='timelineLine' class='absolute left-[13px] md:left-[23px] w-[2px] bg-hairline' aria-hidden='true'></div>
                <div id='timelineMarker'
                     class='absolute left-[7px] md:left-[17px] top-0 w-3.5 h-3.5 rounded-full bg-accent shadow-[0_0_0_5px_var(--accent-wash)] transition-transform duration-200 ease-out z-[2]'
                     aria-hidden='true'></div>
                {experiences.map((exp, index) => (
                    <Fragment>
                        <ExperienceCard experience={exp}/>
                        {index === 0 && (
                            <div id='timelineFlashback' class='grid grid-cols-[28px_1fr] md:grid-cols-[48px_1fr]'>
                                <div aria-hidden='true'></div>
                                <h3 class='kicker mb-7'>How I got here</h3>
                            </div>
                        )}
                    </Fragment>
                ))}
            </div>
        </div>
    </section>

    <!-- Education -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] reveal'>
            <p class='kicker mb-4'>Education journey</p>
            <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight mb-10'>
                Where it started.
            </h2>
            <div class='grid md:grid-cols-2 gap-6'>
                {education.map((edu) => <EducationCard education={edu}/>)}
            </div>
        </div>
    </section>

    <!-- Contact -->
    <div class='border-t border-hairline'>
        <ContactBlock variant='row'/>
    </div>
</BaseLayout>

<style is:global>
    /* Direction-dependent text is rendered twice; .order-story picks which shows.
       This keeps the Phase 2 toggle to a single class flip — no string rewriting. */
    .cue-forward {
        display: none;
    }

    .order-story .cue-back {
        display: none;
    }

    .order-story .cue-forward {
        display: inline;
    }

    /* The leading card has nothing before it — true in either order, so :first-child
       handles both without position logic. */
    .timeline-entry:first-child .direction-cue {
        display: none;
    }

    .timeline-entry .story-card {
        /* Anchor the left edge so the gap to the timeline rail never changes */
        transform-origin: left center;
        transition: transform var(--dur-base) var(--ease-standard),
            box-shadow var(--dur-base) var(--ease-standard);
    }

    .timeline-entry.is-active .story-card {
        transform: scale(1.02);
        box-shadow: var(--shadow-card);
    }

    @media (prefers-reduced-motion: reduce) {
        .timeline-entry.is-active .story-card {
            transform: none;
        }
    }
</style>

<script is:inline>
    if (!window.__timelineBound) {
        window.__timelineBound = true;

        // The traveling dot follows a reading line at 35% of the viewport;
        // the entry under that line is the focused one.
        const DOT_CENTER_OFFSET = 55; /* rail pt-12 (48) + half dot (7) */
        let ticking = false;

        const update = () => {
            ticking = false;
            const timeline = document.getElementById('experienceTimeline');
            const marker = document.getElementById('timelineMarker');
            const line = document.getElementById('timelineLine');
            if (!timeline || !marker || !line) return;
            const entries = Array.from(timeline.querySelectorAll('.timeline-entry'));
            if (!entries.length) return;

            const focusY = window.innerHeight * 0.35 - timeline.getBoundingClientRect().top;
            const firstCenter = entries[0].offsetTop + DOT_CENTER_OFFSET;
            const lastCenter = entries[entries.length - 1].offsetTop + DOT_CENTER_OFFSET;

            // The rail runs exactly from the first dot's center to the last dot's center
            line.style.top = `${firstCenter}px`;
            line.style.height = `${lastCenter - firstCenter}px`;

            const y = Math.min(Math.max(focusY, firstCenter), lastCenter);
            marker.style.transform = `translateY(${y - 7}px)`;

            // The entry whose milestone the traveling dot currently sits on
            let markerEntry = entries[0];
            for (const entry of entries) {
                if (entry.offsetTop + DOT_CENTER_OFFSET - 14 <= y) markerEntry = entry;
            }

            // Focus that entry's card only once it is fully on screen (below the
            // sticky nav); cards taller than the viewport qualify while they fill
            // it. Measured from untransformed layout so the scale can't flicker.
            const NAV_CLEARANCE = 88;
            const viewportBottom = window.innerHeight;
            const card = markerEntry.querySelector('.story-card');
            let active = null;
            if (card) {
                const top = markerEntry.getBoundingClientRect().top;
                const bottom = top + card.offsetHeight;
                const fullyVisible = top >= NAV_CLEARANCE && bottom <= viewportBottom;
                const fillsScreen = top <= NAV_CLEARANCE && bottom >= viewportBottom;
                if (fullyVisible || fillsScreen) active = markerEntry;
            }
            entries.forEach((entry) => entry.classList.toggle('is-active', entry === active));
        };

        const request = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };

        window.addEventListener('scroll', request, {passive: true});
        window.addEventListener('resize', request, {passive: true});
        document.addEventListener('astro:page-load', request);
        // Re-measure when content height changes (story expand/collapse)
        if ('ResizeObserver' in window) {
            new ResizeObserver(request).observe(document.documentElement);
        }
    }
</script>
