---
import {SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, FULL_NAME, LINKEDIN_ACCOUNT} from '../consts';
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {Image} from 'astro:assets';
import MainPicture from '@src/assets/img/ava.jpg';
import Byline from '../components/Byline.astro';
import SkillCard from '../components/SkillCard.astro';
import StackLine from '../components/StackLine.astro';
import ToolboxMarquee from '../components/ToolboxMarquee.astro';
import ContactBlock from '../components/ContactBlock.astro';
import {getSortedPosts} from '../utils/posts';
import {getOrderedProjects} from '../utils/projects';
import {getExperiences, isCurrentRole, formatExperienceDate} from '../utils/experiences';

// Newest first, current role on top
const experiences = (await getExperiences()).reverse();
const skills = (await getCollection('majorSkills')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getOrderedProjects()).filter((p) => p.data.isFeatured);
const latestPosts = (await getSortedPosts()).slice(0, 4);
const recommendations = (await getCollection('recommendations')).sort((a, b) => a.data.id - b.data.id);
const interests = await getCollection('interests');

// First sentence of the recommendation body, used as the pull quote.
// Bodies contain raw HTML markup, so strip tags before extracting.
const pullQuote = (body: string | undefined) => {
    const text = (body ?? '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
    return text.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? text;
};

const RECOMMENDATIONS_URL = `${LINKEDIN_ACCOUNT}/details/recommendations/`;
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} gradient='glow'>
    <!-- 1 · Hero -->
    <section class='shell'>
        <div class='grid lg:grid-cols-[1.15fr_.85fr] gap-12 lg:gap-20 pt-16 lg:pt-[88px] pb-20 items-center'>
            <div class='cascade'>
                <p class='kicker flex items-center gap-3 mb-6'>
                    <span class='w-[3px] h-4 bg-accent inline-block'></span>
                    Senior software engineer · Ain Salah, Algeria
                </p>
                <h1 class='font-display text-5xl md:text-7xl font-semibold text-strong tracking-[-0.015em] leading-[1.1] mb-7'>
                    Make it <span class='marker-wash'>work</span>, then <span class='marker-wash whitespace-nowrap'>make it last</span>.
                </h1>
                <p class='text-[21px] text-muted leading-relaxed max-w-[560px] mb-9'>
                    At my core, I'm a problem-solver. I untangle complex challenges by leading teams and building
                    software with the resources at hand. I write about what I learn along the way.
                </p>
                <div class='flex flex-wrap gap-4'>
                    <a href='/about/' class='btn btn-primary btn-lg'>About me</a>
                    <a href='/posts/' class='btn btn-secondary btn-lg'>Read the writing</a>
                </div>
            </div>
            <div class='flex flex-col items-center gap-6'
                 style='animation: rise-in var(--dur-slow) var(--ease-standard) 400ms backwards;'>
                <Image src={MainPicture} alt={FULL_NAME} width={760}
                       class='w-[380px] max-w-full aspect-[4/5] object-cover rounded-tile shadow-card' loading='eager'/>
                <Byline/>
            </div>
        </div>
    </section>

    <!-- 2 · Experience teaser -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] grid lg:grid-cols-[420px_1fr] gap-12 lg:gap-20 reveal'>
            <div class='lg:sticky lg:top-28 self-start'>
                <p class='kicker mb-4'>2019 → Today</p>
                <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight mb-5'>
                    The story behind my experience.
                </h2>
                <p class='text-base text-muted leading-relaxed mb-7'>
                    From a first backend job in Dubai to leading teams and managing development for US startups, to
                    consulting for Swedish clients today. The full story, with the lessons attached, lives on the About page.
                </p>
                <a href='/about/' class='btn btn-secondary arrow-link !text-strong'>Read the full story <span class='arrow'>→</span></a>
            </div>
            <div>
                {experiences.map((exp) => (
                        <div class='flex items-center gap-4 py-3.5 border-b border-hairline'>
                            <span class='text-[13px] text-muted tabular-nums w-[150px] shrink-0 hidden sm:block'>
                                {formatExperienceDate(exp.data.startDate)} → {formatExperienceDate(exp.data.endDate)}
                            </span>
                            <span class:list={[
                                'w-2 h-2 rounded-full shrink-0',
                                isCurrentRole(exp) ? 'bg-accent' : 'border border-accent'
                            ]}></span>
                            <span class='text-base font-semibold text-strong grow'>{exp.data.roleName}</span>
                            <span class='text-sm text-muted text-right hidden md:block'>
                                {[exp.data.companyName, exp.data.location].filter(Boolean).join(' · ')}
                            </span>
                        </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 3 · Major skills -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] reveal'>
            <p class='kicker mb-4'>What I do</p>
            <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight mb-10'>
                Four hats, one job: make it work.
            </h2>
            <div class='sm:columns-2 gap-6'>
                {skills.map((skill) => <SkillCard skill={skill}/>)}
            </div>
        </div>
    </section>

    <!-- 4 · Featured projects -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] reveal'>
            <div class='flex items-end justify-between gap-4 mb-10'>
                <div>
                    <p class='kicker mb-4'>Open source · Featured</p>
                    <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight'>
                        Built in the open.
                    </h2>
                </div>
                <a href='/projects/' class='arrow-link text-[15px] shrink-0'>All projects <span class='arrow'>→</span></a>
            </div>
            <div class='grid md:grid-cols-3 gap-6'>
                {featuredProjects.map((project) => (
                        <div class='cardx cardx-hover p-8'>
                            <div class='flex items-center gap-3 flex-wrap mb-4'>
                                <h3 class='font-display text-[26px] font-semibold text-strong'>
                                    <a href={project.data.demoLink} target='_blank' rel={project.data.demoLinkRel}>
                                        {project.data.name}
                                    </a>
                                </h3>
                                {project.data.isUnderConstruction && <span class='badge-accent badge-pulse'>In progress</span>}
                                {project.data.version && <span class='badge-outline'>v{project.data.version}</span>}
                            </div>
                            <p class='text-[15px] text-muted leading-relaxed mb-5'>
                                {project.data.description ?? project.body}
                            </p>
                            <StackLine tags={project.data.tags ?? []}/>
                        </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 5 · Writing -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] grid lg:grid-cols-[420px_1fr] gap-12 lg:gap-20 reveal'>
            <div>
                <p class='kicker mb-4'>Field notes</p>
                <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight mb-5'>
                    I write now and then.
                </h2>
                <p class='text-base text-muted leading-relaxed mb-7'>
                    Not often. Only when there's something worth saying. Lessons from the trenches, system design
                    notes, and the occasional prompt that earns its keep.
                </p>
                <a href='/posts/' class='arrow-link text-[15px]'>All posts <span class='arrow'>→</span></a>
            </div>
            <div>
                {latestPosts.map((post) => (
                        <a href={`/${post.id}/`}
                           class='flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6 py-5 border-b border-hairline group'>
                            <span class='text-[13px] text-muted tabular-nums w-[100px] shrink-0'>
                                {post.data.pubDate.toLocaleDateString('en-us', {month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC'})}
                            </span>
                            <span class='font-display text-[21px] font-semibold text-strong leading-snug group-hover:text-accent transition-colors duration-200'>
                                {post.data.title}
                            </span>
                        </a>
                ))}
            </div>
        </div>
    </section>

    <!-- 6 · Recommendations -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] reveal'>
            <div class='flex flex-col items-start gap-4 mb-10 md:flex-row md:items-end md:justify-between'>
                <div>
                    <p class='kicker mb-4'>Kind words · LinkedIn recommendations</p>
                    <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight'>
                        From the people I've worked with.
                    </h2>
                </div>
                <a href={RECOMMENDATIONS_URL} target='_blank' class='arrow-link text-[15px] shrink-0'>
                    All recommendations on LinkedIn <span class='arrow'>→</span>
                </a>
            </div>
            <div class='grid md:grid-cols-2 gap-6'>
                {recommendations.map((rec) => (
                        <div class='cardx p-8'>
                            <blockquote class='font-display text-[19px] italic text-body leading-relaxed mb-5'>
                                “{rec.data.pullQuote ?? pullQuote(rec.body)}”
                            </blockquote>
                            <p class='text-[13.5px] text-muted'>
                                {rec.data.name} · {rec.data.title} · {rec.data.relationship}
                            </p>
                        </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 7 · Toolbox marquee -->
    <section class='border-t border-hairline'>
        <div class='shell pt-[72px] pb-10 reveal'>
            <p class='kicker mb-4'>The toolbox · Always moving</p>
            <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight'>
                Tools I reach for.
            </h2>
        </div>
        <div class='pb-[72px]'>
            <ToolboxMarquee/>
        </div>
    </section>

    <!-- 8 · Interests -->
    <section class='border-t border-hairline'>
        <div class='shell py-[72px] reveal'>
            <p class='kicker mb-4'>Off the clock</p>
            <h2 class='font-display text-4xl md:text-[44px] font-semibold text-strong leading-tight mb-10'>
                When I'm not shipping.
            </h2>
            <div class='grid sm:grid-cols-3 gap-6'>
                {interests.map((interest) => (
                        <div class='cardx cardx-hover p-8'>
                            <h3 class='font-display text-[21px] font-semibold text-strong mb-3'>{interest.data.title}</h3>
                            <p class='text-sm text-muted leading-relaxed'>{interest.data.description}</p>
                        </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 9 · Contact -->
    <div class='border-t border-hairline'>
        <ContactBlock variant='centered'/>
    </div>
</BaseLayout>
