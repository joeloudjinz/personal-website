---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import {getOrderedProjects} from '../../utils/projects';

const projects = await getOrderedProjects();
const nugetCount = projects.filter((project) => project.data.publishedPackageLink).length;

// Row-major masonry: odd positions fill the left column, even the right,
// so items 1|2, 3|4… pair up while every card keeps its natural height.
const masonryColumns = [
    projects.filter((_, i) => i % 2 === 0),
    projects.filter((_, i) => i % 2 === 1)
];
---

<BaseLayout
        title="Abdellah Addoun's Projects Gallery"
        description='Find a humble list of open source projects I worked on or contributed to over time.'
        gradient='subtle'>
    <!-- Header -->
    <section class='shell pt-16 pb-14 cascade'>
        <p class='kicker mb-5'>Open source · {projects.length} projects, {nugetCount} on NuGet</p>
        <h1 class='font-display text-4xl md:text-[56px] font-semibold text-strong tracking-[-0.015em] leading-tight mb-6'>
            Projects gallery.
        </h1>
        <p class='text-[21px] text-muted leading-relaxed max-w-[760px]'>
            Open source projects I worked on or contributed to over time. Feel free to check them out. If you have
            any feedback, I'm happy to hear it.
        </p>
    </section>

    <!-- Masonry grid -->
    <section class='shell pb-[72px]'>
        <!-- Mobile: single column in list order -->
        <div class='flex flex-col gap-6 md:hidden reveal'>
            {projects.map((project) => <ProjectItem project={project}/>)}
        </div>
        <!-- md+: two masonry columns paired row-major from the curated order -->
        <div class='hidden md:grid md:grid-cols-2 gap-6 items-start reveal'>
            {masonryColumns.map((column) => (
                    <div class='flex flex-col gap-6'>
                        {column.map((project) => <ProjectItem project={project}/>)}
                    </div>
            ))}
        </div>
        <p class='text-center font-display text-[21px] italic text-muted mt-14'>
            More projects are yet to come, inchallah.
        </p>
    </section>
</BaseLayout>
