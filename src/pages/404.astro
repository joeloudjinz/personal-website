---
import SpatialLayout from '../layouts/SpatialLayout.astro';
import '../styles/spatial/pages/404.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<SpatialLayout title={'404 Page Not Found - ' + SITE_TITLE} description={SITE_DESCRIPTION + ' 404 Page Not Found'} page="404">
  <section id="lost" aria-labelledby="nf-h" class="nf in-a">
    <div class="sp-win sp-tint sp-mat nf-card" style="animation-delay:.1s">
      <p class="sp-kick">404 · Page not found</p>
      <h1 id="nf-h" class="nf-h1">This page took a detour.</h1>
      <p class="nf-p">The link may be old, or the page has moved. While the background keeps looking for it, here are the main roads.</p>
      <div class="nf-roads"><a href="/" class="sp-btn sp-pri">Back home</a><a href="/projects/" class="sp-btn sp-sec">Projects</a><a href="/posts/" class="sp-btn sp-sec">Writing</a><a href="/about/" class="sp-btn sp-sec">About</a></div>
      <p class="nf-hint"><span class="nf-hint-move">Look behind this card: the caramel signal is still searching. </span>Press and hold any empty space to see what runs underneath the site.</p>
    </div>
  </section>
</SpatialLayout>

<script is:inline data-astro-rerun>
  // Save-Data has no media query, so the stylesheet needs a class to hide the sentence about moving signals.
  if (navigator.connection && navigator.connection.saveData) document.documentElement.classList.add('save-data');
</script>
