---
// The pinboard template: the Joe Inz Design System showcase. Layout and
// behavior live here; every user-visible string comes from the entry.
// Copy rules for entry strings: no em-dashes, no semicolons, human register.
//
// Comments in this file are scanned as raw bytes by Tailwind — see the note in
// tailwind.config.mjs before writing one.
import BaseLayout from '@src/layouts/BaseLayout.astro';
import ProjectAnalytics from '@src/components/ProjectAnalytics.astro';
import {splitWash, type PinboardEntry} from '@src/utils/projectPages';
// The system's real drawn marks, copied from the CD project's assets and
// inlined as markup so their ink variables can read the page's theme tokens,
// which an img element cannot offer. Geometry is verbatim; only the long
// documentation blocks were trimmed.
import monogramSvg from './monogram-aa.svg?raw';
import wordmarkSvg from './wordmark-ar-outline.svg?raw';

interface Props {
    page: PinboardEntry;
}

const {page} = Astro.props;
// Destructured here so the sections read their copy off one line rather than
// reaching into page.data each time.
const {seo, projectName, masthead, mirror, railCaption, railNote, allLabel, stops, pins, closing} = page.data;

const canonical = `https://${page.data.subdomain}/`;

// Same wash contract as the band pages, split by the same shared helper. Null
// is unreachable (the schema enforces wash-in-heading) but the render guards it
// anyway, exactly as BandPage does.
const mastheadWash = splitWash(masthead.heading, masthead.wash);
const closingWash = splitWash(closing.heading, closing.wash);

// Where a contrast ratio sits on the audit's meter track. The track runs
// from 1 to 10 rather than to the 21 a ratio can theoretically reach: real
// text pairings live between 3 and 10, and a track scaled to 21 would squash
// every one of them into its first half and show a reader nothing. The track
// deliberately carries no end label, because the only mark on it that means
// anything is the floor. Anything at or beyond 10 simply fills it.
const meterPercent = (ratio: number) => Math.max(0, Math.min(100, ((ratio - 1) / 9) * 100));
---

<BaseLayout title={seo.title} description={seo.description ?? mirror.en.body} gradient='warm'
            keywords={seo.keywords?.join(', ')} imageAlt={seo.imageAlt}
            canonical={canonical} chrome='subdomain' projectName={projectName}>
    {/* Page-only faces. A <link> in the body is valid HTML and keeps the fonts
        off every other page. The site's Fraunces/Inter still load via BaseHead
        for the shared chrome.

        All five of the system's faces. An earlier cut of this page left Amiri
        out because nothing spoke in it, with a note that it would join the day
        a pin needed it — the expanded pins are that day: the faces row renders
        its specimen and the nameplate's law cards set the name in it. Only 400
        and 700 are requested because Amiri ships nothing else, and the
        system's own law forbids synthesising the weights a face lacks. */}
    <link rel='stylesheet'
          href='https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,500&family=Readex+Pro:wght@400;500;600;700&family=Harmattan:wght@400;700&family=Amiri:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap'/>

    {/* Without a script this page has no reveal to wait for. global.css starts
        .reveal at opacity 0 and only the observer in BaseLayout adds
        .is-visible, so the mirror, all nine pins and the whole closing band
        would stay blank — nearly the entire page. .marker-wash is the same
        observer's other client: its bar starts at scaleX(0), so both washed
        headings would lose their marking. Both are handed their finished state
        here instead.

        The masthead's .cascade is deliberately NOT in this list. Its children
        are hidden the same way but un-hidden by a CSS animation that ends at
        opacity 1 and holds it (fill-mode forwards), which needs no script at
        all — naming it here, and turning that animation off, is the one thing
        that WOULD leave it unpainted. ("unpainted" rather than the obvious
        utility name on purpose: Tailwind scans this file as plain text, so
        spelling that name here emits its rule into the shared bundle even
        though no element ever carries the class. See tailwind.config.mjs.)

        is:inline keeps this where it is written: an Astro <style> is otherwise
        hoisted into the page's stylesheet, where it would apply to everyone.
        A style element in a body noscript is technically non-conforming (the
        fonts link above IS body-legal, this is the case that is not), but every
        engine honours it and BaseLayout offers no head slot to put it in.

        What stays inert without a script, accepted by the spec: the rail stops
        and the mirror flip do nothing, the theme stays light, and the proofs
        control falls back to its own fragment jump. The content all reads. */}
    <noscript>
        <style is:inline>
            .reveal { opacity: 1 !important; transform: none !important; }
            .marker-wash::before { transform: none !important; }
            /* The expanded panels open on click, and a click needs the script.
               The old unfolds were details elements and read scriptless for
               free; these panels are held shut by the hidden attribute
               instead, so with no script they are simply shown, every one,
               and the board reads in full. The affordance buttons stay inert
               and honest: aria-expanded false on a button above an already
               shown panel is wrong, so they are stood down here. */
            .dsp-exp[hidden] { display: grid !important; }
            .dsp-open { display: none !important; }
        </style>
    </noscript>

    <div class='dsp'>
        <header class='shell pt-[72px] pb-[8px]'>
            <div class='flex flex-wrap items-end justify-between gap-7'>
                <div class='cascade'>
                    <p class='kicker mb-6'>{masthead.kicker}</p>
                    <h1 class='dsp-display font-semibold text-strong tracking-[-0.015em] leading-[1.05]'>
                        {mastheadWash
                            ? <>{mastheadWash.before}<span class='marker-wash whitespace-nowrap'>{mastheadWash.washed}</span>{mastheadWash.after}</>
                            : masthead.heading}
                    </h1>
                    {/* The plain answer to "what am I looking at", placed
                        before anything else on the page. Everything below it
                        describes a design system to someone who already knows
                        what one is. */}
                    <p class='dsp-sub'>{masthead.sub}</p>
                </div>
                <div class='flex flex-col items-end gap-3 pb-[10px]'>
                    {/* A second control on the site's ONE theme mechanism, not a
                        second mechanism. The class is the whole wiring: the
                        handler in Header.astro is delegated on the document and
                        acts on anything matching .theme-toggle, so this button
                        gets the class flip, the localStorage write and the
                        aria-pressed sync for free, and the two controls cannot
                        drift apart because there is only one of them.

                        Both labels are rendered and CSS picks one off the html
                        class. No script writes this text, which is what makes it
                        right on the first paint of a dark-mode load — a label
                        set by JS would say "Turn the lights off" until the
                        handler caught up. Hiding with display also keeps the
                        accessible name honest: only the shown label is in it. */}
                    <button class='dsp-modebtn theme-toggle' type='button'>
                        <span class='dsp-lbl-to-dark'>{masthead.lightSwitch.toDark}</span>
                        <span class='dsp-lbl-to-light'>{masthead.lightSwitch.toLight}</span>
                    </button>
                    {/* .stack-line paints the middle dot at the START of each fact
                        after the first, so a dot can never wrap onto a line by
                        itself, and it draws them in caramel. Same run BandPage
                        gives its closing facts; the mono and the 11px are this
                        page's register and stay in .dsp-facts. */}
                    <p class='stack-line dsp-facts justify-end'>
                        {masthead.facts.map((fact) => <span class='stack-tag'>{fact}</span>)}
                    </p>
                </div>
            </div>
        </header>
        {/* The featured element: one idea in two scripts, and the control
            between them swaps which one is read first.

            Each side pins its own dir. The card's flow direction is what the
            flip changes — .is-flipped sets direction: rtl on the card, which
            reverses the two grid tracks — and without dir='ltr' the English
            side would inherit that flow and set its own sentences right to
            left, moving every full stop to the wrong end. Direction of flow
            and direction of script are two different questions here, and the
            markup answers them separately. */}
        {/* The id's one reader is ProjectAnalytics' section_view observer, and
            the same is true of the closing section's. The board between them is
            deliberately not in that funnel: rail_focus is its signal, and a
            section_view of the board would restate what that event already
            answers. */}
        <section class='shell mt-6 reveal' id='mirror'>
            <div class='dsp-mirror relative grid grid-cols-1 min-[860px]:grid-cols-2 overflow-hidden'
                 id='dsp-mirror'>
                {/* The one element here that deliberately pins no dir: its
                    "EN ⇄ عربي" label reverses along with the card, which is the
                    whole point of it.

                    Named for the action, not for the scripts, and the state
                    rides aria-pressed — the same label-stable pattern the
                    header's theme toggle uses. Hard-coded false because the
                    flip is never restored on load, so English-first is always
                    where a fresh page starts. */}
                <button class='dsp-flipbtn' type='button' data-mirror-flip
                        aria-pressed='false' aria-label='EN عربي, switch the reading direction'>
                    EN <span aria-hidden='true'>⇄</span> <b lang='ar'>{mirror.flipLabel}</b>
                </button>
                <div class='dsp-mside px-7 py-12 min-[860px]:px-16 min-[860px]:py-14' dir='ltr'>
                    <p class='kicker mb-3'>{mirror.en.kicker}</p>
                    <h2 class='dsp-mhead'>{mirror.en.heading}</h2>
                    <p class='dsp-mbody'>{mirror.en.body}</p>
                </div>
                <div class='dsp-mside dsp-mside-ar px-7 py-12 min-[860px]:px-16 min-[860px]:py-14'
                     dir='rtl' lang='ar'>
                    <p class='kicker dsp-kicker-ar mb-3'>{mirror.ar.kicker}</p>
                    <h2 class='dsp-mhead dsp-mhead-ar'>{mirror.ar.heading}</h2>
                    <p class='dsp-mbody dsp-mbody-ar'>{mirror.ar.body}</p>
                </div>
            </div>
        </section>
        {/* The rail and the board. The rail does two jobs at once: it follows
            whichever pin the pointer or the keyboard is on, and a click on a
            stop pins that highlight and dims every pin belonging elsewhere.
            Both halves are bindRail below.

            A plain stack under 900px and a two-track layout above it, rather
            than a two-track layout that narrows: the rail is a different
            object at each size — a row of chips that scrolls sideways, and a
            vertical spine with a dot per stop — and the narrow one has to be
            free of the wide one's row to pin itself under the site's bar. */}
        {/* The proofs button scrolls to this wrapper rather than to the board
            inside it, so the rail lands on screen with the stop it just chose
            already lit — under 900px the rail is a row ABOVE the board, and
            stopping at the board's own top edge would leave it overhead.

            The clearance is the token every anchor target on the site reads,
            because this is the same question: how far below the sticky bar a
            jumped-to thing has to start. See --anchor-offset in global.css. */}
        <div class='shell mt-9 pb-8 block min-[900px]:grid min-[900px]:grid-cols-[216px_1fr] min-[900px]:gap-9 scroll-mt-[var(--anchor-offset)]'
             id='dsp-railboard'>
            {/* Named by the page's own caption rather than by a string written
                in here, so project #2's rail announces itself in its own words.
                The caption is drawn only at the wide layout and the name
                survives that: text referenced by aria-labelledby is read out
                whether or not it is on screen. */}
            <nav class='dsp-rail sticky self-start z-10 mb-6 min-[900px]:mb-0' aria-labelledby='dsp-railcap'>
                <p class='dsp-railcap hidden mb-2.5 ml-5 min-[900px]:block' id='dsp-railcap'>{railCaption}</p>
                {/* An exclusive filter group, so the pressed state sits on each
                    stop rather than on the row. Authored here as well as kept
                    in step by the script: with no JS the rail is still a set of
                    buttons that say which one is current. */}
                <div class='dsp-railline flex gap-2 overflow-x-auto min-[900px]:flex-col min-[900px]:gap-0 min-[900px]:overflow-visible'>
                    <button class='dsp-stop is-on relative shrink-0 whitespace-nowrap text-left' type='button'
                            data-rail-stop='all' aria-pressed='true'>{allLabel}</button>
                    {stops.map((stop) => (
                        <button class='dsp-stop relative shrink-0 whitespace-nowrap text-left' type='button'
                                data-rail-stop={stop.id} aria-pressed='false'>{stop.label}</button>
                    ))}
                </div>
                <p class='dsp-railnote hidden mt-4 ml-5 min-[900px]:block'>{railNote}</p>
            </nav>

            {/* The board's own track holds two things stacked: the podium an
                opened pin is shown on, and the packed board under it. They
                share one grid cell so the rail stays alongside both rather
                than being pushed down the page by whatever is open.

                min-w-0 because a grid item's floor is its content's width,
                and a multi-column box would sooner run past the track than
                narrow itself to fit. */}
            <div class='min-w-0'>
                {/* Where an opened pin is shown, and the answer to the two
                    things wrong with opening one in place: a pin that grew
                    where it stood shoved its neighbours around differently
                    depending on which column it was in, and a pin opened at
                    the foot of the board opened off screen. One fixed place,
                    directly above the board, is neither. Empty until a pin is
                    promoted into it, and drawn away entirely while empty so
                    the board sits exactly where it always did. */}
                <div class='dsp-podium scroll-mt-[var(--anchor-offset)]' id='dsp-podium'></div>

            <div class='dsp-board columns-1 gap-5 min-[580px]:columns-2 min-[900px]:columns-3' id='dsp-board'>
                {pins.map((pin, index) => (
                    /* The tab stop is what lets the rail follow the keyboard,
                       and it is also what would put every pin in a screen
                       reader's list unnamed — so each is named by its own
                       label. No role: ARIA allows none of the grouping roles
                       on an article, and the name alone conforms, so a pin
                       reads "02 · the palette, article" and the Arabic pin
                       announces itself in Arabic. */
                    /* data-pin-index is what sends a pin home. A promoted pin
                       leaves the board entirely, so on the way back it has to
                       be put in front of the first pin ordered after it —
                       appending would file every pin that was ever opened at
                       the end of the story. */
                    <article class:list={['dsp-pin', 'reveal', 'relative', 'inline-block', 'w-full', 'mb-5', 'p-6', 'break-inside-avoid',
                                          {'dsp-pin-dark': pin.kind === 'quote' || pin.kind === 'terminal'}]}
                             data-pin-stop={pin.stop} data-pin-index={index}
                             tabindex='0' aria-labelledby={`dsp-pin-${index}`}>
                        <span class='dsp-pindot absolute' aria-hidden='true'></span>
                        {/* Every label is English, including the Arabic pin's.
                            The specimens on that pin stay Arabic, which is the
                            argument it is making, but its label is a signpost
                            rather than a specimen and a signpost nobody can
                            read is not one. */}
                        <span class='dsp-lbl block mb-3' id={`dsp-pin-${index}`}>{pin.label}</span>

                        {pin.kind === 'origin' && (
                            <div class='text-center'>
                                {/* The site's own avatar, not an entry asset — so the
                                    entry writes the description and the component owns
                                    the file. Sized down from the 400px original, which
                                    is why the intrinsic box is stated and the drawn
                                    width is not left to the layout. */}
                                <img src='/avatar.png' alt={pin.alt} width='400' height='400' loading='lazy'
                                     class='dsp-bubble block mx-auto mt-1 h-auto w-[172px]'/>
                                <p class='dsp-anno dsp-anno-c mt-3'>{pin.note}</p>
                            </div>
                        )}
                        {pin.kind === 'swatches' && (
                            <>
                                <div class='grid grid-cols-2 gap-2'>
                                    {pin.colors.map((color) => (
                                        <span class='dsp-sw relative block h-14' style={`background:${color.hex}`}>
                                            <i class:list={['absolute', 'bottom-1', 'left-1.5', 'not-italic', 'px-1.5', 'py-0.5',
                                                            {'dsp-sw-light': color.ink === 'light'}]}>{color.name}</i>
                                        </span>
                                    ))}
                                </div>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {pin.kind === 'stat' && (
                            <>
                                <p class='dsp-statn'>{pin.value}</p>
                                <p class='dsp-statc mt-2'>{pin.caption}</p>
                            </>
                        )}
                        {/* Curly marks, not the typewriter pair: the page is a
                            design system showing its own manners. */}
                        {/* The register picks the face, exactly as the mirror's
                            strip says it does: warm speaks in the display serif,
                            sharp in the sans. */}
                        {pin.kind === 'quote' && (
                            <p class:list={['dsp-quote', {'dsp-quote-sharp': pin.register === 'sharp'}]}>“{pin.text}”</p>
                        )}
                        {pin.kind === 'nameplate' && (
                            <>
                                <div dir='rtl' lang='ar' class='text-right'>
                                    <p class='dsp-arname'>{pin.name}</p>
                                    <p class='dsp-arbody mt-1.5'>{pin.body}</p>
                                </div>
                                {/* The one English line on this pin. It names
                                    the subject so a reader who cannot read the
                                    specimen can still choose to open it, and
                                    it describes rather than translates, so
                                    nothing above becomes a translation of it. */}
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {pin.kind === 'faces' && (
                            <>
                                <p class='dsp-proofline mt-0.5'>Aa <span lang='ar'>ع</span></p>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {/* Written with no gaps between the tag and the
                            expression on purpose: inside a pre, any air left
                            around them is drawn. */}
                        {pin.kind === 'terminal' && (
                            <>
                                <pre class='dsp-term'>{pin.lines.map((line) => (
                                    <span>{line.prompt ? '$ ' : ''}{line.text}</span>
                                ))}<span class='dsp-cursor' aria-hidden='true'></span></pre>
                                {/* The pane is an ordinary build, deliberately:
                                    it is a specimen of what the system does to
                                    a terminal, not a claim about a tool. The
                                    claim is the note, in the same annotation
                                    the palette and the states carry. */}
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {pin.kind === 'states' && (
                            <>
                                <div class='flex flex-wrap gap-2'>
                                    {pin.items.map((item) => (
                                        <span class={`dsp-st dsp-st-${item.tone} rounded-full px-3 py-1`}>{item.glyph} {item.name}</span>
                                    ))}
                                </div>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {pin.kind === 'audit' && (
                            <>
                                <dl class='dsp-audit'>
                                    {pin.rows.map((row) => (
                                        <div class='flex justify-between gap-3'><dt>{row.check}</dt><dd>{row.result}</dd></div>
                                    ))}
                                </dl>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}

                        {/* The affordance that replaced the old unfold: same
                            register, same spot, but it lifts the whole pin
                            onto the podium above the board instead of growing
                            a paragraph inside the column. data-pin-open
                            carries the pin's label because the expand event
                            reports opens by which pin was opened, exactly as
                            the unfolds did. */}
                        {pin.expansion && (
                            <button class='dsp-open mt-3.5 inline-flex items-center gap-1.5' type='button'
                                    aria-expanded='false' aria-controls={`dsp-exp-${index}`}
                                    data-pin-open={pin.label}>
                                <span class='dsp-chev' aria-hidden='true'>›</span> {pin.expansion.label}
                            </button>
                        )}
                        {pin.expansion && (
                            <div class='dsp-exp' id={`dsp-exp-${index}`} hidden>
                                {pin.kind === 'origin' && pin.expansion && (
                                    <>
                                        <p class='dsp-expintro'>{pin.expansion.intro}</p>
                                        <div class='dsp-marks'>
                                            {pin.expansion.marks.map((mark) => (
                                                <figure class='dsp-mark'>
                                                    <div class='dsp-markart'>
                                                        {mark.mark === 'bubble' && (
                                                            <img src='/avatar.png' alt='' width='400' height='400' loading='lazy'
                                                                 class='block h-auto w-[104px]'/>
                                                        )}
                                                        {mark.mark === 'monogram' && (
                                                            <>
                                                                {/* Twice on purpose: the drawing, and the same
                                                                    drawing at its published 24px floor. */}
                                                                <span class='dsp-monogram block w-[88px]'><Fragment set:html={monogramSvg}/></span>
                                                                <span class='dsp-monogram block w-6'><Fragment set:html={monogramSvg}/></span>
                                                            </>
                                                        )}
                                                        {mark.mark === 'wordmark' && (
                                                            <span class='dsp-wordmark block w-full max-w-[230px]'><Fragment set:html={wordmarkSvg}/></span>
                                                        )}
                                                    </div>
                                                    <figcaption class='dsp-markcap'><b>{mark.title}</b>{mark.job}</figcaption>
                                                </figure>
                                            ))}
                                        </div>
                                        <ul class='dsp-laws'>
                                            {pin.expansion.laws.map((law) => <li>{law}</li>)}
                                        </ul>
                                    </>
                                )}
                                {pin.kind === 'swatches' && pin.expansion?.demo === 'budget' && (
                                    <>
                                        <p class='dsp-expintro'>{pin.expansion.intro}</p>
                                        <div class='dsp-jobs'>
                                            {pin.expansion.jobs.map((job) => (
                                                <div class='dsp-job'>
                                                    <div class='dsp-jobart'>
                                                        {/* Inert samples, deliberately: spans wearing the
                                                            five treatments, not five working controls a
                                                            keyboard would have to walk through. */}
                                                        {job.job === 'kicker' && <span class='dsp-spec-kicker'>{job.sample}</span>}
                                                        {job.job === 'wash' && <span class='dsp-spec-wash'>{job.sample}</span>}
                                                        {job.job === 'action' && <span class='dsp-spec-btn'>{job.sample}</span>}
                                                        {job.job === 'focus' && <span class='dsp-spec-field'>{job.sample}</span>}
                                                        {job.job === 'selection' && <span class='dsp-spec-sel'>{job.sample}</span>}
                                                    </div>
                                                    <p class='dsp-jobcap'>{job.caption}</p>
                                                </div>
                                            ))}
                                        </div>
                                        <div class='dsp-strip'>
                                            <p class='dsp-exptitle'>{pin.expansion.strip.title}</p>
                                            <div class='dsp-stripchips'>
                                                {pin.colors.map((color) => (
                                                    <span class='dsp-sw relative block h-12' style={`background:${color.hex}`}>
                                                        <i class:list={['absolute', 'bottom-1', 'left-1.5', 'not-italic', 'px-1.5', 'py-0.5',
                                                                        {'dsp-sw-light': color.ink === 'light'}]}>{color.name}</i>
                                                    </span>
                                                ))}
                                                {/* The one value that moves in dark: caramel as text
                                                    steps up. A displayed value, so labelled by it. */}
                                                <span class='dsp-sw relative block h-12' style='background:#C68A45'>
                                                    <i class='absolute bottom-1 left-1.5 not-italic px-1.5 py-0.5 dsp-sw-light'>#C68A45</i>
                                                </span>
                                            </div>
                                            <p class='dsp-expnote'>{pin.expansion.strip.note}</p>
                                        </div>
                                    </>
                                )}
                                {pin.kind === 'swatches' && pin.expansion?.demo === 'chart' && (
                                    <>
                                        <p class='dsp-expintro'>{pin.expansion.intro}</p>
                                        <div class='dsp-chart'>
                                            {pin.colors.map((color, seriesIndex) => (
                                                <div class='dsp-bar'>
                                                    <span>{color.name}</span>
                                                    <i class={`dsp-vz${seriesIndex + 1}`} style={`height:${[62, 80, 46, 68, 36, 52, 26][seriesIndex] ?? 45}%`}></i>
                                                </div>
                                            ))}
                                        </div>
                                        <p class='dsp-expnote'>{pin.expansion.chartNote}</p>
                                        <div class='dsp-ramps'>
                                            <div>
                                                <div class='dsp-rampline'>{[1, 2, 3, 4, 5, 6].map((step) => <i class={`dsp-sq${step}`}></i>)}</div>
                                                <p class='dsp-rampcap'>{pin.expansion.seqLabel}</p>
                                            </div>
                                            <div>
                                                <div class='dsp-rampline'>{[1, 2, 3, 4, 5, 6, 7].map((step) => <i class={`dsp-dv${step}`}></i>)}</div>
                                                <p class='dsp-rampcap'>{pin.expansion.divLabel}</p>
                                            </div>
                                            <div>
                                                <div class='dsp-rampline'><i class='dsp-nullsq'></i></div>
                                                <p class='dsp-rampcap'>{pin.expansion.nullLabel}</p>
                                            </div>
                                        </div>
                                        <p class='dsp-expnote'>{pin.expansion.nullNote}</p>
                                    </>
                                )}
                                {/* Handed to a parameter because the narrowing
                                    to the ladder branch does not survive into
                                    the row callback below. */}
                                {pin.kind === 'stat' && pin.expansion?.demo === 'ladder' && ((ladder) => (
                                    <>
                                        <p class='dsp-expintro'>{ladder.intro}</p>
                                        <div class='dsp-ladder'>
                                            {ladder.rows.map((row, rowIndex) => (
                                                <div class='dsp-lrow'>
                                                    <span class='dsp-lmeta'>{row.role} · {row.px}px</span>
                                                    <span class:list={['dsp-lsample', rowIndex < 4 ? 'dsp-l-serif' : 'dsp-l-sans',
                                                                      {'dsp-l-label': row.role === 'label'}]}
                                                          style={`font-size:${row.px}px`}>{ladder.sample}</span>
                                                    <span class:list={['dsp-lsample-ar', rowIndex < 4 ? 'dsp-l-ar' : 'dsp-l-arsans',
                                                                      {'dsp-l-arlabel': row.role === 'label'}]}
                                                          style={`font-size:${row.arPx}px`} lang='ar' dir='rtl'>{ladder.arSample}</span>
                                                </div>
                                            ))}
                                            {/* The density demo: the body step again at the
                                                published utility factor, 16 times 0.9375. */}
                                            <div class='dsp-lrow'>
                                                <span class='dsp-lmeta'>{ladder.rows[4]?.role} · ×0.9375</span>
                                                <span class='dsp-lsample dsp-l-sans' style='font-size:15px'>{ladder.sample}</span>
                                                <span class='dsp-lsample-ar dsp-l-arsans' style='font-size:15px' lang='ar' dir='rtl'>{ladder.arSample}</span>
                                            </div>
                                        </div>
                                        <p class='dsp-expnote'>{ladder.denseNote}</p>
                                        <p class='dsp-expnote'>{ladder.arNote}</p>
                                    </>
                                ))(pin.expansion)}
                                {pin.kind === 'stat' && pin.expansion?.demo === 'motion' && (
                                    <>
                                        <p class='dsp-expintro'>{pin.expansion.intro}</p>
                                        <div class='dsp-stage' data-motion-stage>
                                            <div class='dsp-stagecard'><span class='dsp-stageglyph' aria-hidden='true'>Aa</span></div>
                                            <span class='dsp-stagechip' aria-hidden='true'></span>
                                            <button class='dsp-replay' type='button' data-motion-replay>{pin.expansion.replayLabel}</button>
                                        </div>
                                        <p class='dsp-expnote'>{pin.expansion.enterCaption}</p>
                                        <p class='dsp-expnote'>{pin.expansion.stateCaption}</p>
                                        <p class='dsp-expnote'>{pin.expansion.reducedNote}</p>
                                    </>
                                )}
                                {pin.kind === 'quote' && pin.expansion && (
                                    <>
                                        <p class:list={['dsp-sib', {'dsp-sib-sharp': pin.register === 'sharp'}]}
                                           lang='ar' dir='rtl'>«{pin.expansion.sibling}»</p>
                                        <p class='dsp-expnote'>{pin.expansion.note}</p>
                                    </>
                                )}
                                {pin.kind === 'nameplate' && pin.expansion && (
                                    <div dir='rtl' lang='ar' class='text-right'>
                                        {pin.expansion.intro && <p class='dsp-expintro dsp-expintro-ar'>{pin.expansion.intro}</p>}
                                        <div class='dsp-arlaws'>
                                            {pin.expansion.specimens.map((specimen) => (
                                                <div class='dsp-arlaw'>
                                                    <span class={`dsp-arspec dsp-arspec-${specimen.law}`}>{specimen.sample}</span>
                                                    <span class='dsp-arcap'>{specimen.caption}</span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                {pin.kind === 'faces' && pin.expansion && (
                                    <>
                                        {pin.expansion.intro && <p class='dsp-expintro'>{pin.expansion.intro}</p>}
                                        <div class='dsp-facelist'>
                                            {pin.expansion.rows.map((row) => (
                                                <div class='dsp-facerow'>
                                                    {row.face === 'literata' && <span class='dsp-facespec dsp-f-lit' aria-hidden='true'>Aa</span>}
                                                    {row.face === 'readex' && <span class='dsp-facespec dsp-f-rdx' aria-hidden='true'>Aa</span>}
                                                    {row.face === 'harmattan' && <span class='dsp-facespec dsp-f-har' lang='ar' aria-hidden='true'>ع</span>}
                                                    {row.face === 'amiri' && <span class='dsp-facespec dsp-f-ami' lang='ar' aria-hidden='true'>ع</span>}
                                                    {row.face === 'mono' && <span class='dsp-facespec dsp-f-mono' aria-hidden='true'>{'{}'}</span>}
                                                    <p class='dsp-facemeta'><b>{row.name}</b>{row.job}</p>
                                                </div>
                                            ))}
                                        </div>
                                    </>
                                )}
                                {pin.kind === 'terminal' && pin.expansion && (
                                    <>
                                        {pin.expansion.intro && <p class='dsp-expintro'>{pin.expansion.intro}</p>}
                                        <div class='dsp-devgrid'>
                                            <div>
                                                <p class='dsp-exptitle'>{pin.expansion.diffTitle}</p>
                                                <pre class='dsp-devpre'>{pin.expansion.diff.map((line) => (
                                                    <span class={`dsp-d-${line.mark}`}><i>{line.mark === 'add' ? '+' : line.mark === 'drop' ? '-' : '~'}</i>{line.text}</span>
                                                ))}</pre>
                                                <p class='dsp-expnote mt-2.5'>{pin.expansion.diffNote}</p>
                                            </div>
                                            <div>
                                                <p class='dsp-exptitle'>{pin.expansion.logTitle}</p>
                                                <pre class='dsp-devpre'>{pin.expansion.logs.map((line) => (
                                                    <span class={`dsp-g-${line.level}`}><i>{line.level}</i>{line.text}</span>
                                                ))}</pre>
                                                <p class='dsp-expnote mt-2.5'>{pin.expansion.logNote}</p>
                                            </div>
                                            <div>
                                                <p class='dsp-exptitle'>{pin.expansion.ansiTitle}</p>
                                                <div class='dsp-ansi'>
                                                    {Array.from({length: 16}, (_, slot) => <i class={`dsp-a${slot}`}></i>)}
                                                </div>
                                                <p class='dsp-expnote mt-2.5'>{pin.expansion.ansiNote}</p>
                                            </div>
                                        </div>
                                    </>
                                )}
                                {pin.kind === 'states' && pin.expansion && (
                                    <>
                                        <p class='dsp-expintro'>{pin.expansion.intro}</p>
                                        <div class='dsp-strows'>
                                            {pin.expansion.items.map((item) => (
                                                <div class='dsp-strow'>
                                                    <span class={`dsp-stx dsp-stx-${item.tone} rounded-full px-3 py-1`}>{item.glyph} {item.name}</span>
                                                    <p class='dsp-strowcap'>{item.caption}</p>
                                                </div>
                                            ))}
                                        </div>
                                    </>
                                )}
                                {pin.kind === 'audit' && pin.expansion && (
                                    <>
                                        <p class='dsp-expintro'>{pin.expansion.intro}</p>
                                        <div class='dsp-auditgrid'>
                                            {/* Each measurement drawn against the one
                                                threshold it has to clear, so the figures
                                                mean something to a reader who has never
                                                met a contrast ratio. The floor is the
                                                only mark on the track, and it is labelled
                                                where it stands rather than in a legend,
                                                which is the dataviz layer's own rule. The
                                                offset is set once on the container and
                                                every track reads it. */}
                                            <div class='dsp-meters' style={`--dsp-floor:${meterPercent(pin.expansion.floor)}%`}>
                                                <span class='dsp-floorhead' aria-hidden='true'><i>{pin.expansion.floorLabel}</i></span>
                                                <dl class='dsp-meterlist'>
                                                    {pin.expansion.rows.map((row) => (
                                                        <div class='dsp-meter'>
                                                            <dt>{row.check}</dt>
                                                            {/* The bar repeats what the figure
                                                                beside it already says, so it is
                                                                decoration to a screen reader. */}
                                                            <span class='dsp-metertrack' aria-hidden='true'>
                                                                <i style={`width:${meterPercent(row.ratio)}%`}></i>
                                                            </span>
                                                            <dd>{row.ratio}:1</dd>
                                                        </div>
                                                    ))}
                                                </dl>
                                            </div>
                                            <div>
                                                <p class='dsp-exptitle'>{pin.expansion.flaggedTitle}</p>
                                                <div class='dsp-flags'>
                                                    {pin.expansion.flagged.map((flag) => (
                                                        <p class='dsp-flag'><b>{flag.pair}</b>{flag.note}</p>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>
                                        {/* The first exhibit. A ratio printed on its own
                                            asks to be taken on trust, so each pairing is
                                            drawn in the ink it names on the ground it was
                                            measured against. The hexes come from the entry
                                            and never move with the theme: a measurement
                                            shown in colours other than the ones it was
                                            taken on is not that measurement. */}
                                        <div>
                                            <p class='dsp-exptitle'>{pin.expansion.pairsTitle}</p>
                                            <div class='dsp-pairs'>
                                                {pin.expansion.pairs.map((pair) => (
                                                    <div class='dsp-pair'>
                                                        <span class='dsp-pairink' style={`background:${pair.ground};color:${pair.ink}`}>{pair.label}</span>
                                                        <span class='dsp-pairratio'>{pair.ratio}</span>
                                                    </div>
                                                ))}
                                            </div>
                                            <p class='dsp-expnote mt-2.5'>{pin.expansion.pairsNote}</p>
                                        </div>
                                        {/* The second exhibit, and the one thing on this
                                            board a reader can genuinely check rather than
                                            believe: the chart series run through the
                                            colour-blindness simulation the system says it
                                            ran. The chips reuse the same classes the chart
                                            pin draws, so there is one set of published
                                            values and no chance of the proof and the claim
                                            drifting apart.

                                            sRGB interpolation is stated because the SVG
                                            default is linearised, which would wash the
                                            simulation out and understate the very thing it
                                            is here to test. The matrices are the published
                                            dichromacy approximations, which is why the copy
                                            calls this a simulation rather than a verdict. */}
                                        <div>
                                            <p class='dsp-exptitle'>{pin.expansion.simTitle}</p>
                                            <svg aria-hidden='true' focusable='false' width='0' height='0' style='position:absolute'>
                                                <filter id='dsp-cvd-deuteranopia' color-interpolation-filters='sRGB'>
                                                    <feColorMatrix type='matrix' values='0.625 0.375 0 0 0 0.7 0.3 0 0 0 0 0.3 0.7 0 0 0 0 0 1 0'/>
                                                </filter>
                                                <filter id='dsp-cvd-protanopia' color-interpolation-filters='sRGB'>
                                                    <feColorMatrix type='matrix' values='0.567 0.433 0 0 0 0.558 0.442 0 0 0 0 0.242 0.758 0 0 0 0 0 1 0'/>
                                                </filter>
                                            </svg>
                                            <div class='dsp-sims'>
                                                {pin.expansion.simRows.map((row) => (
                                                    <div class='dsp-simrow'>
                                                        <span class='dsp-simlbl'>{row.label}</span>
                                                        <div class={`dsp-simchips dsp-cvd-${row.kind}`}>
                                                            {[1, 2, 3, 4, 5, 6, 7].map((series) => <i class={`dsp-vz${series}`}></i>)}
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                            <p class='dsp-expnote mt-2.5'>{pin.expansion.simNote}</p>
                                        </div>
                                    </>
                                )}
                            </div>
                        )}
                    </article>
                ))}
            </div>
            </div>
        </div>
        {/* The closing. One statement, the contract behind it, and a way back
            into the board — the two controls are the only places on the page
            that ask for anything. */}
        {/* id read by section_view, like the mirror's — see the note there. */}
        <section class='border-t border-hairline mt-4' id='closing'>
            <div class='shell py-20 text-center reveal'>
                <h2 class='dsp-closing font-semibold text-strong tracking-[-0.015em] leading-[1.1]'>
                    {closingWash
                        ? <>{closingWash.before}<span class='marker-wash whitespace-nowrap'>{closingWash.washed}</span>{closingWash.after}</>
                        : closing.heading}
                </h2>
                <p class='dsp-closingsub'>{closing.sub}</p>
                <div class='flex gap-3 justify-center items-start flex-wrap'>
                    {/* The summary IS the primary button. No data-pin-open here:
                        the summary already reports as a cta click, and one click
                        must not report as two events.

                        These two attributes do not finish the job, though. A
                        summary raises click when it CLOSES as well as when it
                        opens, so Task 8's cta_click listener has to drop the
                        closing half or a reader who folds the contract back up
                        is counted as having pressed the button twice. The test
                        is cheap: a summary's activation runs after the event has
                        finished propagating, so at listener time details.open
                        still carries the value from BEFORE the click — open
                        means this click is the one closing it. */}
                    <details class='dsp-contract'>
                        <summary class='dsp-btn dsp-btn-pri' data-cta='primary' data-cta-location='closing'>{closing.contract.label}</summary>
                        {/* The prohibitions are the contract's teeth, so the
                            bold belongs to them rather than to the permissions. */}
                        <div class='dsp-contractbody'>
                            <p>{closing.contract.may}</p>
                            <p><strong>{closing.contract.never}</strong></p>
                        </div>
                    </details>
                    {/* A link rather than a button, because #dsp-railboard is a
                        real place on this page and a fragment jump is what
                        still gets a reader there with no script running. The
                        wrapper's scroll-mt-[var(--anchor-offset)] means even
                        that bare jump lands clear of the site's bar.

                        The script upgrades it in place: preventDefault, then
                        the focus, the rail's own click and the motion-aware
                        scroll that the plain jump cannot do. No role is added
                        — a control that takes you to a fragment IS a link, and
                        .dsp-btn is display: inline-block, so an anchor wears it
                        exactly as the button did. */}
                    <a class='dsp-btn dsp-btn-sec' href='#dsp-railboard' data-proofs-stop={closing.proofsStop}
                       data-cta='secondary' data-cta-location='closing'>{closing.proofsLabel}</a>
                </div>
            </div>
        </section>
    </div>

    <style>
        /* Page-scoped additions only. Everything else reads the site's own
           tokens (--cream, --choc, --caramel, --hairline, gradients, grain),
           which global.css already defines. Never import the DS foundation.css
           here: it declares the same names with 1.x values and would rewire the
           shared chrome. */
        .dsp {
            --dsp-font-display: 'Literata', Georgia, serif;
            --dsp-font-sans: 'Readex Pro', system-ui, sans-serif;
            --dsp-font-ar: 'Harmattan', sans-serif;
            --dsp-font-ar-formal: 'Amiri', Georgia, serif;
            --dsp-font-mono: 'JetBrains Mono', monospace;
            --dsp-ease: cubic-bezier(.2, .7, .3, 1);
            --dsp-dur-state: .25s;  /* hover, press, and the pressed states. Reduced motion does not
                                       spare this: global.css clamps every duration on the page to
                                       1ms, so the colour still changes and simply lands at once
                                       instead of over a quarter second. The feedback survives, the
                                       travel does not, which is the right half to keep.
                                       No enter duration is declared beside it because the page has
                                       none of its own — the one-time entrance is the site's .cascade
                                       and .reveal on the site's --dur-slow, and global.css switches
                                       both off under reduced motion rather than clamping them. */
            --dsp-dur-flip: .18s;   /* the dip has to cover the swap, so CSS and the script read one
                                       number. Keep it in seconds: the script multiplies by 1000. */
            --dsp-dur-move: .34s;   /* the pins' travel when a row opens and the board reflows
                                       around it. Never fired under reduced motion: the script
                                       skips the whole measured glide rather than letting the
                                       global clamp cut it down. */
            /* Caramel as TEXT, which is a different budget from caramel as a
               mark. --accent is 3.1:1 on cream and 3.7:1 on navy — enough for a
               dot, a bar or a fill, and short of the 4.5:1 a 12px control label
               needs. So the marks keep --accent and anything set in the accent
               reads this instead: the same caramel walked toward the page's own
               ink in light, and the brighter caramel the site already carries
               in dark. 4.7:1 and 4.6:1 against the pins they sit on. */
            --dsp-accent-ink: color-mix(in srgb, var(--accent) 72%, var(--choc-ink));
            font-family: var(--dsp-font-sans);
        }
        :global(html.theme-dark) .dsp { --dsp-accent-ink: var(--caramel-bright); }

        /* ---- The masthead ---- */
        /* Two independent bounds, and they answer different questions.

           The clamp floors at 30px because that is the condition washFits is
           measured at — 600 weight, 30px, Georgia as the display fallback,
           -0.015em — so keeping the floor here is what lets the schema's wash
           check hold for this heading with no second metrics table. That bound
           is about ONE un-wrappable phrase against a 320px screen.

           max-width is a measure cap on the WHOLE heading, and is no part of
           the washFit contract: it decides where a long line breaks at desktop
           widths, where the clamp is at its 84px ceiling and nothing is close to
           overflowing. Changing it cannot make a legal wash illegal, and cannot
           rescue an over-long one either. */
        .dsp-display {
            font-family: var(--dsp-font-display);
            font-size: clamp(30px, 8.5vw, 84px);
            max-width: 12ch;
        }
        /* Sits under the display heading and above everything else. Measured
           rather than sized to match the heading: this is the one paragraph on
           the page that a visitor who knows nothing has to read, so it takes
           the body register and a comfortable line, not the display voice. The
           max-width is wider than the heading's 12ch cap because a sentence
           wants a reading measure, not a headline one. */
        .dsp-sub {
            margin: 18px 0 0; max-width: 52ch;
            font-size: 15px; line-height: 1.65; color: var(--text-body);
        }
        .dsp-facts { font-family: var(--dsp-font-mono); font-size: 11px; line-height: 1.8; }
        /* One page, one theme control. The pill below is this page's own voice
           for the question, and the header's segmented control says the same
           thing again a few pixels away — so the header's is stood down here,
           and only here. inzsh has no masthead switch and keeps its own.

           Presentation and nothing else: the mechanism is untouched. The
           delegated handler in Header.astro still acts on anything carrying
           .theme-toggle, the pill still rides it, and the hidden control is
           still kept in step by the same aria-pressed sync.

           Conditioned on the page rather than written as a bare :global rule,
           because the two project showcase pages SHARE one stylesheet — both
           link the same _project_ chunk, so an unconditional rule in here would
           hide inzsh's toggle as well. .dsp is this template's root and appears
           on no other page in the build, so :has() asks the one question that
           tells the two apart.

           The child combinator is the other half of the aim. The site's bar is
           a child of body; this page's masthead is a <header> too, further in
           and with the pill inside it, so a plain descendant match would hide
           the very control this rule exists to leave standing. */
        :global(body:has(.dsp) > header .theme-toggle) { display: none; }
        .dsp-modebtn {
            cursor: pointer; border: 1.5px solid var(--text-strong); background: transparent;
            color: var(--text-strong); border-radius: 999px; font-weight: 600; font-size: 13px;
            padding: 9px 20px;
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state), border-color var(--dsp-dur-state);
        }
        /* The label is the page's darkest ink and not --on-accent: see the note
           on .dsp-btn-pri, which is the third control to fill with the accent
           and the place the reasoning is written out. 4.59:1 in both modes. */
        .dsp-modebtn:hover { background: var(--accent); border-color: var(--accent); color: var(--choc-ink); }
        /* The label is a consequence of the theme class, never of the click. */
        :global(html.theme-dark) .dsp-lbl-to-dark,
        :global(html:not(.theme-dark)) .dsp-lbl-to-light { display: none; }

        /* ---- The mirror ---- */
        /* The mirror card. Its split, padding, position and clipping are plain
           layout and ride Tailwind utilities in the markup; what stays here is
           what reads a token, draws state, or has to survive the flip. */
        .dsp-mirror {
            border: 1px solid var(--hairline);
            border-radius: 20px;
            background: color-mix(in srgb, var(--cream) 60%, transparent);
        }
        :global(html.theme-dark) .dsp-mirror { background: color-mix(in srgb, var(--navy-soft) 70%, transparent); }
        /* The flip itself: the card's flow reverses, so the two tracks trade
           places. Each side keeps its own dir, so no sentence is disturbed. */
        .dsp-mirror.is-flipped { direction: rtl; }
        .dsp-mside { transition: opacity var(--dsp-dur-flip) ease, transform var(--dsp-dur-flip) ease; }
        .dsp-mirror.is-swapping .dsp-mside { opacity: 0; transform: scale(.985); }

        /* The seam between the sides. It is drawn on the Arabic column, on
           whichever edge faces the English one, and that edge changes when the
           card flips — so it is stated as a physical edge and swapped by the
           state class. A flow-relative edge cannot say it: it would resolve
           against the Arabic column's own dir, which never changes, rather
           than against the card's flow, which is the thing that flips.

           Stacked, the seam is horizontal instead. The width here has to stay
           in step with the min-[860px]:grid-cols-2 utility on .dsp-mirror. */
        .dsp-mside-ar { border-top: 1px solid var(--hairline); }
        @media (min-width: 860px) {
            .dsp-mside-ar { border-top: 0; border-left: 1px solid var(--hairline); }
            .dsp-mirror.is-flipped .dsp-mside-ar { border-left: 0; border-right: 1px solid var(--hairline); }
        }

        .dsp-mhead {
            font-family: var(--dsp-font-display);
            font-size: clamp(22px, 2.6vw, 30px);
            font-weight: 600;
            line-height: 1.2;
            color: var(--text-strong);
            margin: 0 0 8px;
        }
        .dsp-mbody { font-size: 13.5px; color: var(--text-muted); line-height: 1.65; margin: 0; }
        /* The system's Arabic rules, applied rather than described: a larger
           size, a looser leading, and never any letter spacing. */
        .dsp-mhead-ar { font-family: var(--dsp-font-ar); font-weight: 700; font-size: clamp(26px, 3vw, 36px); line-height: 1.4; }
        .dsp-mbody-ar { font-family: var(--dsp-font-ar); font-size: 16px; line-height: 1.85; }
        .dsp-kicker-ar { font-family: var(--dsp-font-ar); font-size: 13px; letter-spacing: 0; text-transform: none; }

        .dsp-flipbtn {
            cursor: pointer; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3;
            border: 1.5px solid var(--text-strong); background: var(--cream); color: var(--text-strong);
            border-radius: 999px; font-weight: 600; font-size: 12.5px; padding: 8px 16px;
            box-shadow: var(--shadow-card);
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state), transform var(--dsp-dur-state);
        }
        /* Only the ground differs in dark: the border and the label are already
           --text-strong in the base rule, which IS cream once the theme flips,
           and restating them here bought nothing.

           :not(:hover) is the point of this rule, not a flourish. A scoped
           :global(html.theme-dark) selector outweighs a scoped :hover one — an
           extra class and a type selector against a single pseudo-class — so
           written plainly this rule won in dark mode even while the pointer was
           on the button, and the hover below painted nothing at all there. It
           had been that way since the flip was built. Standing the rest state
           down while the pointer is on the button says the intent directly and
           leaves the hover to win on its own. */
        :global(html.theme-dark) .dsp-flipbtn:not(:hover) { background: var(--navy-soft); }
        /* Same accent fill and the same ink as the other two accent fills. */
        .dsp-flipbtn:hover { background: var(--accent); border-color: var(--accent); color: var(--choc-ink); transform: translate(-50%, -50%) scale(1.05); }
        .dsp-flipbtn b { font-family: var(--dsp-font-ar); font-weight: 700; font-size: 15px; }

        /* ---- The story rail ---- */
        /* Pinned under the site's own bar rather than at a bare 20px: the
           header is sticky and 85px tall, so anything that pins itself to the
           top of the window reads --nav-height or ends up drawn beneath it.

           Narrow first. What is written plainly here is the chip row; the
           spine, and the dot per stop that only a spine can carry, are declared
           inside the 900px query rather than switched off outside it. */
        .dsp-rail { top: var(--nav-height); }
        .dsp-railline {
            border: 1px solid var(--hairline);
            border-radius: 999px;
            /* Solid, because pins scroll underneath it. Content showing
               through a sticky control row reads as dirt on the row rather
               than as depth, and the row needs no translucency to feel light:
               a hairline, a pill and a page's worth of air already say it. */
            background: var(--surface);
            padding: 5px;
            /* The row is a pill and a platform scrollbar draws a grey bar
               across the bottom of it. The half-cut chip at the right edge is
               the affordance, and it is the one the design draws. */
            scrollbar-width: none;
        }
        .dsp-railline::-webkit-scrollbar { display: none; }
        .dsp-stop {
            cursor: pointer;
            background: none;
            border: none;
            border-radius: 999px;
            padding: 7px 14px;
            font-family: inherit;
            font-size: 13.5px;
            color: var(--text-muted);
            transition: color var(--dsp-dur-state), background-color var(--dsp-dur-state);
        }
        .dsp-stop:hover { color: var(--text-strong); }
        /* The trade, named exactly: a mouse click leaves the browser's focus
           indicator on the chip it landed on until something else takes focus,
           and a marked chip standing beside the lit one reads as a second
           current stop. Keyboard focus keeps its indicator, which is the half
           that was ever doing any work.

           Longhand, never the shorthand — see the byte-scan note in
           tailwind.config.mjs, and the same care CodeBlock takes. The shorthand
           property name is a utility name, and so is the usual word for the
           indicator itself, which is why neither is written on this page. */
        .dsp-stop:focus:not(:focus-visible) { outline-style: none; }
        /* A wash under the current chip rather than a solid accent fill. A
           filled accent needs an ink dark enough to sit on it — see the note on
           .dsp-btn-pri, where the page's three accent fills settle that — and
           this is a 13.5px label with no fill to sit on; the marker wash puts
           the page's strong ink on caramel at 12:1 in light and 7.8:1 in dark,
           in the same caramel the headings are marked with. */
        .dsp-stop.is-on { color: var(--text-strong); font-weight: 600; background: var(--accent-wash); }
        .dsp-railcap {
            font-family: var(--dsp-font-mono); font-size: 9.5px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--text-muted);
        }
        .dsp-railnote { font-family: var(--dsp-font-mono); font-size: 11.5px; line-height: 1.6; color: var(--text-muted); }

        @media (min-width: 900px) {
            .dsp-rail {
                top: calc(var(--nav-height) + 20px);
                /* One source for the spine's geometry, because the dot and the
                   line between dots have to agree exactly and are drawn by two
                   different rules. */
                --dsp-dot-top: 13px;
                --dsp-dot-size: 11px;
                --dsp-spine-w: 3px;
            }
            .dsp-railline {
                border: 0;
                border-radius: 0;
                background: none;
                /* The 3px the spine used to occupy as a left border on this
                   column, kept as padding now that the line is drawn stop by
                   stop, so every dot stays exactly where it was. */
                padding: 0 0 0 var(--dsp-spine-w);
            }
            .dsp-stop { padding: 9px 0 9px 20px; border-radius: 0; }
            .dsp-stop.is-on { background: none; }
            /* Preflight makes every box border-box, so the 11px here is the
               whole dot and the 3px band around it eats inward. That is what
               puts the dot's centre on the spine at left: -7px, which is half
               the dot plus half the line.

               z-index because the segment below starts at this dot's own
               centre and ::after paints over ::before on the same element. The
               dot has to sit on top of the line, not under it. */
            .dsp-stop::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: -7px;
                top: var(--dsp-dot-top);
                width: var(--dsp-dot-size);
                height: var(--dsp-dot-size);
                border-radius: 50%;
                background: var(--surface);
                border: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
                transition: background-color var(--dsp-dur-state), border-color var(--dsp-dur-state), transform var(--dsp-dur-state);
            }
            /* The spine, drawn one segment at a time: from this stop's own dot
               down to the next stop's. Every stop is the same height and every
               dot sits at the same offset inside it, so a segment that starts
               at the dot's centre and runs the height of one stop lands exactly
               on the next dot's centre, with no number here having to know what
               that height is.

               Two things fall out of drawing it this way rather than as a
               border down the whole column: the first segment starts AT the
               first dot instead of above it, and the last stop draws no segment
               at all, so the line stops at the final dot instead of running on
               past it. */
            .dsp-stop::after {
                content: "";
                position: absolute;
                left: calc(0px - var(--dsp-spine-w));
                top: calc(var(--dsp-dot-top) + var(--dsp-dot-size) / 2);
                width: var(--dsp-spine-w);
                height: 100%;
                background: color-mix(in srgb, var(--accent) 35%, transparent);
            }
            .dsp-stop:last-child::after { content: none; }
            .dsp-stop:hover::before { transform: scale(1.15); }
            .dsp-stop.is-on::before { background: var(--accent); border-color: var(--accent); }
        }

        /* ---- The board ---- */
        /* A packed multi-column board: the pins differ in height by design and
           the browser fits them together. Which is also why the rail follows
           the pointer and never the scroll offset — a packed board has no one
           vertical order to read a current stop out of. */
        .dsp-pin {
            background: color-mix(in srgb, var(--cream) 55%, transparent);
            border: 1px solid var(--hairline);
            border-radius: 20px;
            box-shadow: var(--shadow-soft);
            /* transform rides the travel duration because the expansion
               script animates it: every pin that stays on the board glides
               from where it was to where the repack put it. The hover lift
               shares that channel and simply rides the same number now. */
            transition: transform var(--dsp-dur-move) var(--dsp-ease), box-shadow .3s var(--dsp-ease), opacity .45s ease, filter .45s ease;
        }
        /* The podium, and the pin standing on it. The pin keeps its own skin
           on purpose — same surface, same edge, same radius, same caramel dot
           — so what opens reads as the pin that was clicked rather than as a
           viewer the board hands things to. Only its width changes.

           display is restated because the pins are laid inline-block for the
           column packing, and an inline-block on the podium would carry a
           line box's worth of stray space under it. */
        .dsp-podium:empty { display: none; }
        .dsp-pin.is-open { display: block; }
        /* A full-width panel has nowhere to float to. */
        .dsp-pin.is-open:hover { transform: none; }
        /* The rise a pin plays where it lands, whether that is the podium or
           its own place back on the board. It is deliberately not a journey
           across the board: from the foot of a tall board that trip crosses
           everything else on the way, and the page is already travelling to
           meet the panel. The pins that stay put carry the continuity, gliding
           into the gap the promoted pin left. */
        .dsp-pin.is-rising { animation: dsp-rise var(--dsp-dur-move) var(--dsp-ease) both; }
        @keyframes dsp-rise { from { opacity: 0; transform: translateY(14px); } }
        /* :not() rather than a later override, so the two pins that are navy in
           both modes never enter the argument. */
        :global(html.theme-dark) .dsp-pin:not(.dsp-pin-dark) { background: color-mix(in srgb, var(--navy-soft) 70%, transparent); }
        .dsp-pin:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }
        /* Set back, never taken away: a pin outside the chosen stop keeps its
           place, its text and its tab stop, so the rail is emphasis rather than
           a search. Which is also why reaching one by keyboard restores it —
           .14 is not something a reader can be left stranded in. */
        .dsp-pin.is-dim { opacity: .14; transform: scale(.97); filter: saturate(.35); }
        .dsp-pin.is-dim:focus-within { opacity: 1; transform: none; filter: none; }

        /* ---- The pins ---- */
        .dsp-pindot {
            top: -6px; left: 50%; transform: translateX(-50%);
            width: 12px; height: 12px; border-radius: 50%;
            background: var(--accent); box-shadow: var(--shadow-soft);
            transition: transform var(--dsp-dur-state);
        }
        .dsp-pin:hover .dsp-pindot { transform: translateX(-50%) scale(1.25); }
        .dsp-lbl {
            font-family: var(--dsp-font-mono); font-size: 10px; letter-spacing: .1em;
            text-transform: uppercase; color: var(--text-muted);
        }
        /* The system's Arabic rules again: bigger, and never letter-spaced. */
        .dsp-lbl-ar { font-family: var(--dsp-font-ar); font-size: 13px; letter-spacing: 0; text-transform: none; }

        .dsp-anno {
            font-family: var(--dsp-font-display); font-style: italic; font-size: 14.5px;
            color: var(--text-muted); line-height: 1.55;
        }
        .dsp-anno::before {
            content: ""; display: block; width: 24px; height: 3px;
            background: var(--accent); border-radius: 2px; margin-bottom: 8px;
            transition: width .3s var(--dsp-ease);
        }
        .dsp-pin:hover .dsp-anno::before { width: 44px; }
        .dsp-anno-c { text-align: center; }
        .dsp-anno-c::before { margin-inline: auto; }

        /* The curve is spelled out rather than named: the keyword for it is
           byte-identical to a utility, and Tailwind reads this file as bytes. */
        .dsp-bubble { animation: dsp-float 6.5s cubic-bezier(.42, 0, .58, 1) infinite; }
        @keyframes dsp-float { 50% { transform: translateY(-5px); } }

        .dsp-sw { border: 1px solid var(--hairline); border-radius: 10px; }
        /* The palette is content, so these labels sit on hexes that do not move
           with the theme — and one of them cannot carry a bare label at any
           lightness: cream on caramel reads 3.2:1 and pure white only reaches
           3.7:1. A small ground under the label settles every swatch at once,
           at 8.5:1 or better, and reads as a caption rather than as a repair. */
        .dsp-sw i {
            font-family: var(--dsp-font-mono); font-size: 8.5px; border-radius: 5px;
            color: var(--choc-ink);
            background: color-mix(in srgb, var(--cream-bright) 72%, transparent);
        }
        .dsp-sw i.dsp-sw-light {
            color: var(--cream-soft);
            background: color-mix(in srgb, var(--choc-ink) 62%, transparent);
        }

        .dsp-statn {
            font-family: var(--dsp-font-display); font-size: 76px; font-weight: 600;
            line-height: .95; letter-spacing: -.02em; color: var(--text-strong);
        }
        .dsp-statc { font-size: 12px; line-height: 1.55; color: var(--text-muted); }

        /* Navy in both modes, so everything drawn on it is stated against navy
           rather than against a token that flips underneath it. */
        .dsp-pin-dark { background: var(--navy); border-color: transparent; }
        /* In dark mode the page is that same navy, so these two pins stop being
           cards and become holes. The edge is what says they are still pins —
           and it is drawn rather than the colour changed, because everything
           inside them is written against navy in both modes. */
        :global(html.theme-dark) .dsp-pin-dark { border-color: var(--hairline); }
        .dsp-pin-dark .dsp-lbl { color: var(--cream-muted); }
        /* The annotation reaches a navy pin for the first time with the
           console voice's note. The page's muted ink is chocolate half the
           time, which on navy is unreadable, so the navy pins state the ink
           they are actually drawn against: 8.9:1, the same pairing every
           other line of type on these two pins already uses. The caramel bar
           above it is a mark rather than type and keeps the accent. */
        .dsp-pin-dark .dsp-anno { color: var(--cream-muted); }
        .dsp-quote {
            font-family: var(--dsp-font-display); font-style: italic; font-size: 19px;
            line-height: 1.45; color: var(--cream);
        }
        /* Sharp register: the sans face, upright and front-loaded, a step
           smaller because Readex runs wider than Literata at the same size. */
        .dsp-quote-sharp {
            font-family: var(--dsp-font-sans); font-style: normal; font-weight: 700;
            font-size: 17px; letter-spacing: -0.01em;
        }

        .dsp-arname {
            font-family: var(--dsp-font-ar); font-size: 33px; font-weight: 700;
            line-height: 1.45; color: var(--text-strong);
        }
        .dsp-arbody { font-family: var(--dsp-font-ar); font-size: 14.5px; line-height: 1.8; color: var(--text-muted); }
        .dsp-proofline {
            font-family: var(--dsp-font-display); font-size: 64px; font-weight: 600;
            line-height: 1; color: var(--text-strong);
        }
        .dsp-proofline span { font-family: var(--dsp-font-ar); font-weight: 700; }

        /* One step below the pin it sits in, which is what makes it a well
           rather than a rectangle the same colour as its surroundings. */
        .dsp-term {
            background: var(--navy-deep); border-radius: 12px; color: var(--cream-muted);
            font-family: var(--dsp-font-mono); font-size: 11.5px; line-height: 1.7;
            padding: 14px 16px; overflow-x: auto;
        }
        /* A command stays on one line and the well scrolls sideways under it
           instead — which is what a terminal does, and the same call CodeBlock
           and BandPage write out for code: a wrapped command is not a command,
           it is two lines a reader has to reassemble before they can run it.
           Stated on the lines rather than on the well, so the pane can scroll
           while nothing inside it is allowed to fold. */
        .dsp-term span { display: block; white-space: pre; }
        .dsp-term .dsp-cursor {
            display: inline-block; width: 7px; height: 13px; background: var(--cream-muted);
            vertical-align: -2px; animation: dsp-blink 1.15s steps(1) infinite;
        }
        @keyframes dsp-blink { 50% { opacity: 0; } }

        /* Two colours per state and not one: the wash carries the hue and the
           ink carries the reading. Two of the four inks are derived from the
           site's ramp in each mode — walked toward the page's ink in light, and
           the ramp's own bright end in dark — and the other two are authored,
           because the site has no token for a negative or a caution. Every ink
           below is 4.5:1 or better on its own wash, measured in both modes. */
        .dsp-st {
            font-size: 11px; font-weight: 600;
            background: color-mix(in srgb, var(--dsp-st-tone) 16%, transparent);
            color: var(--dsp-st-ink);
        }
        .dsp-st-positive { --dsp-st-tone: var(--sage);     --dsp-st-ink: color-mix(in srgb, var(--sage) 70%, var(--choc-ink)); }
        .dsp-st-info     { --dsp-st-tone: var(--ink-blue); --dsp-st-ink: color-mix(in srgb, var(--ink-blue) 70%, var(--choc-ink)); }
        .dsp-st-negative { --dsp-st-tone: #8E4A42;         --dsp-st-ink: #7A3A33; }
        .dsp-st-caution  { --dsp-st-tone: #B8912F;         --dsp-st-ink: #6B5219; }
        :global(html.theme-dark) .dsp-st-positive { --dsp-st-ink: var(--sage-bright); }
        :global(html.theme-dark) .dsp-st-info     { --dsp-st-ink: var(--ink-blue-bright); }
        :global(html.theme-dark) .dsp-st-negative { --dsp-st-ink: #C98D85; }
        :global(html.theme-dark) .dsp-st-caution  { --dsp-st-ink: #D4B25E; }

        .dsp-audit { font-family: var(--dsp-font-mono); font-size: 12px; line-height: 2.05; }
        /* --positive walked one step toward the page's ink. Sage alone is 4:1
           on a cream pin and 2.9:1 on a navy one; this is 5.3:1 and 6.6:1, and
           still reads as the same green either side. */
        .dsp-audit dd { color: color-mix(in srgb, var(--positive) 78%, var(--text-strong)); }

        .dsp-open {
            cursor: pointer; border: 0; background: none; padding: 0;
            font-family: inherit; font-size: 12.5px; font-weight: 600; color: var(--dsp-accent-ink);
            transition: color var(--dsp-dur-state);
        }
        .dsp-open:hover { color: var(--text-strong); }
        /* On a navy pin the page's strong ink is chocolate half the time, and
           the light-mode accent ink is a dark caramel. Both are restated. */
        .dsp-pin-dark .dsp-open { color: var(--caramel-bright); }
        .dsp-pin-dark .dsp-open:hover { color: var(--cream); }
        /* Every opening control is English now, including the Arabic pin's, so
           the direction-aware chevron rules this page used to carry are gone.
           Worth keeping the reason on record in case a control is ever set in
           Arabic again: U+203A is bidi-mirrored, so a browser flips the closed
           glyph by itself inside dir='rtl' and must not be turned again, while
           the open state does need its own sign, because a quarter turn
           clockwise points a rightward mark down and a leftward one up. */
        .dsp-chev { display: inline-block; font-size: 11px; transition: transform var(--dsp-dur-state); }
        .dsp-open[aria-expanded='true'] .dsp-chev { transform: rotate(90deg); }
        @keyframes dsp-unfold { from { opacity: 0; transform: translateY(-4px); } }

        /* ---- The expanded panels ---- */
        /* The panel's shut state is the hidden attribute, and the rule below
           restates what the attribute means: the display on the open state
           would otherwise beat the browser's own hiding, because author styles
           outrank user-agent ones even against an attribute. */
        .dsp-exp { display: grid; gap: 18px; border-top: 1px solid var(--hairline); margin-top: 16px; padding-top: 16px; }
        .dsp-exp[hidden] { display: none; }
        .dsp-pin-dark .dsp-exp { border-top-color: color-mix(in srgb, var(--cream) 18%, transparent); }

        .dsp-expintro { font-size: 13.5px; line-height: 1.6; color: var(--text-body); margin: 0; max-width: 62ch; }
        .dsp-expintro-ar { font-family: var(--dsp-font-ar); font-size: 15px; line-height: 1.85; max-width: none; margin-bottom: 12px; }
        .dsp-expnote { font-size: 12.5px; line-height: 1.6; color: var(--text-muted); margin: 0; max-width: 62ch; }
        .dsp-exptitle {
            margin: 0 0 8px; font-family: var(--dsp-font-mono); font-size: 10px;
            letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted);
        }
        .dsp-pin-dark .dsp-expintro { color: var(--cream); }
        .dsp-pin-dark .dsp-expnote { color: var(--cream-muted); }
        .dsp-pin-dark .dsp-exptitle { color: var(--cream-muted); }

        /* The mark family. The drawings, laid into the markup, read the
           page's theme through the ink variables the source assets declare. */
        .dsp-marks { display: grid; gap: 20px; }
        .dsp-mark { margin: 0; display: flex; flex-direction: column; gap: 10px; }
        .dsp-markart { display: flex; align-items: flex-end; gap: 14px; min-height: 108px; }
        .dsp-monogram { --monogram-bg: var(--text-strong); --monogram-ink: var(--surface); }
        .dsp-wordmark { --wordmark-ink: var(--text-strong); align-self: center; }
        .dsp-monogram svg, .dsp-wordmark svg { display: block; width: 100%; height: auto; }
        .dsp-markcap { font-size: 12.5px; line-height: 1.55; color: var(--text-muted); }
        .dsp-markcap b { display: block; color: var(--text-body); margin-bottom: 2px; }
        .dsp-laws { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 12.5px; line-height: 1.55; color: var(--text-muted); }
        .dsp-laws li::before { content: "·"; color: var(--dsp-accent-ink); font-weight: 700; margin-right: 8px; }

        /* The caramel budget, worn by inert samples. */
        .dsp-jobs { display: grid; gap: 16px; }
        .dsp-job { display: flex; flex-direction: column; gap: 8px; }
        .dsp-jobart { display: flex; align-items: center; min-height: 42px; }
        .dsp-jobcap { font-size: 11.5px; line-height: 1.5; color: var(--text-muted); margin: 0; }
        .dsp-spec-kicker {
            font-family: var(--dsp-font-mono); font-size: 11px; letter-spacing: .16em;
            text-transform: uppercase; color: var(--text-strong);
            display: inline-flex; align-items: center; gap: 8px;
        }
        .dsp-spec-kicker::before { content: ""; width: 18px; height: 3px; border-radius: 2px; background: var(--accent); }
        .dsp-spec-wash {
            font-family: var(--dsp-font-display); font-weight: 600; font-size: 17px; color: var(--text-strong);
            background: linear-gradient(transparent 52%, var(--accent-wash) 52%); padding: 0 2px;
        }
        .dsp-spec-btn {
            font-size: 12.5px; font-weight: 600; border-radius: 999px; padding: 8px 16px;
            background: var(--accent); color: var(--choc-ink);
        }
        /* The halo is the foundation's caramel focus, drawn resting: the
           sample is a picture of the state, not a control that has it. */
        .dsp-spec-field {
            font-size: 12.5px; color: var(--text-muted); border: 1px solid var(--hairline); border-radius: 8px;
            padding: 8px 12px; background: var(--surface);
            box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 65%, transparent);
        }
        /* The selection tints from foundation/dev.css, both modes. */
        .dsp-spec-sel { font-size: 13px; color: var(--text-strong); background: #E3D3AE; padding: 1px 3px; }
        :global(html.theme-dark) .dsp-spec-sel { background: #443A2B; }
        .dsp-strip { background: var(--navy); border-radius: 14px; padding: 16px; display: grid; gap: 10px; }
        :global(html.theme-dark) .dsp-strip { border: 1px solid var(--hairline); }
        .dsp-strip .dsp-exptitle, .dsp-strip .dsp-expnote { color: var(--cream-muted); }
        .dsp-stripchips { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }

        /* The ladder. Real sizes inline from the entry's published values. */
        .dsp-ladder { display: grid; }
        .dsp-lrow {
            display: grid; grid-template-columns: 108px 1fr auto; align-items: baseline; gap: 14px;
            padding: 7px 0; border-bottom: 1px dashed color-mix(in srgb, var(--hairline) 75%, transparent);
        }
        .dsp-lrow:last-child { border-bottom: 0; }
        .dsp-lmeta {
            font-family: var(--dsp-font-mono); font-size: 10px; letter-spacing: .08em;
            text-transform: uppercase; color: var(--text-muted);
        }
        .dsp-lsample { color: var(--text-strong); line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .dsp-l-serif { font-family: var(--dsp-font-display); font-weight: 600; letter-spacing: -0.015em; }
        .dsp-l-sans { font-family: var(--dsp-font-sans); font-weight: 500; }
        .dsp-l-label { text-transform: uppercase; letter-spacing: .16em; font-weight: 600; }
        .dsp-lsample-ar { color: var(--text-strong); line-height: 1.4; white-space: nowrap; }
        .dsp-l-ar { font-family: var(--dsp-font-ar); font-weight: 700; }
        .dsp-l-arsans { font-family: var(--dsp-font-sans); font-weight: 500; }
        /* The 13px floor law: the Arabic label keeps the caption size and
           buys its role with weight instead. */
        .dsp-l-arlabel { font-weight: 700; }

        /* The micro-chart. Series colours from foundation/dataviz.css, both
           modes, applied by class so the theme flips them; the collapsed
           chips keep showing the entry's published light values. */
        .dsp-chart {
            display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; align-items: stretch;
            height: 150px; border-bottom: 1px solid var(--hairline); padding: 0 2px;
        }
        .dsp-bar { display: flex; flex-direction: column; justify-content: flex-end; gap: 5px; min-width: 0; }
        .dsp-bar span {
            font-family: var(--dsp-font-mono); font-size: 9px; color: var(--text-muted);
            text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .dsp-bar i { display: block; border-radius: 4px 4px 0 0; }
        .dsp-vz1 { background: #B07A3C; } .dsp-vz2 { background: #41507A; } .dsp-vz3 { background: #55908C; }
        .dsp-vz4 { background: #6E4460; } .dsp-vz5 { background: #5E7A5B; } .dsp-vz6 { background: #7A6119; }
        .dsp-vz7 { background: #7A443A; }
        :global(html.theme-dark) .dsp-vz1 { background: #C68A45; }
        :global(html.theme-dark) .dsp-vz2 { background: #8F9BC4; }
        :global(html.theme-dark) .dsp-vz3 { background: #5D8E89; }
        :global(html.theme-dark) .dsp-vz4 { background: #C9A3CF; }
        :global(html.theme-dark) .dsp-vz5 { background: #8FAE8B; }
        :global(html.theme-dark) .dsp-vz6 { background: #E4CA83; }
        :global(html.theme-dark) .dsp-vz7 { background: #E0A5AF; }
        .dsp-ramps { display: flex; flex-wrap: wrap; gap: 20px 32px; }
        .dsp-rampline { display: flex; gap: 3px; }
        .dsp-rampline i { width: 25px; height: 18px; border-radius: 4px; }
        .dsp-rampcap { margin: 5px 0 0; font-family: var(--dsp-font-mono); font-size: 9.5px; color: var(--text-muted); }
        /* Sequential and diverging ramps from foundation/dataviz.css. */
        .dsp-sq1 { background: #F1E6CC; } .dsp-sq2 { background: #DFC391; } .dsp-sq3 { background: #C79A57; }
        .dsp-sq4 { background: #A5763B; } .dsp-sq5 { background: #7C5527; } .dsp-sq6 { background: #533617; }
        :global(html.theme-dark) .dsp-sq1 { background: #2E2718; }
        :global(html.theme-dark) .dsp-sq2 { background: #4A3A20; }
        :global(html.theme-dark) .dsp-sq3 { background: #6B5229; }
        :global(html.theme-dark) .dsp-sq4 { background: #8F6C33; }
        :global(html.theme-dark) .dsp-sq5 { background: #B58940; }
        :global(html.theme-dark) .dsp-sq6 { background: #DBAF63; }
        .dsp-dv1 { background: #7A443A; } .dsp-dv2 { background: #AC8071; } .dsp-dv3 { background: #D9BCA8; }
        .dsp-dv4 { background: #E7DEC6; } .dsp-dv5 { background: #C0C6A6; } .dsp-dv6 { background: #90A587; }
        .dsp-dv7 { background: #5E7A5B; }
        :global(html.theme-dark) .dsp-dv1 { background: #E0A5AF; }
        :global(html.theme-dark) .dsp-dv2 { background: #C08D9A; }
        :global(html.theme-dark) .dsp-dv3 { background: #8C6C7E; }
        :global(html.theme-dark) .dsp-dv4 { background: #3C4258; }
        :global(html.theme-dark) .dsp-dv5 { background: #5E7A66; }
        :global(html.theme-dark) .dsp-dv6 { background: #77997B; }
        :global(html.theme-dark) .dsp-dv7 { background: #8FAE8B; }
        .dsp-nullsq { width: 56px; background: repeating-linear-gradient(45deg, #B9AC99 0 2px, #E6DCC5 2px 8px); }
        :global(html.theme-dark) .dsp-nullsq { background: repeating-linear-gradient(45deg, #414965 0 2px, #252B42 2px 8px); }

        /* The Arabic register siblings, on the navy quote pins. */
        .dsp-sib { font-family: var(--dsp-font-ar); font-size: 24px; font-weight: 700; line-height: 1.5; color: var(--cream); margin: 0; }
        .dsp-sib-sharp { font-family: var(--dsp-font-sans); font-weight: 700; font-size: 19px; line-height: 1.7; letter-spacing: 0; }

        /* The Arabic type laws, each a bordered specimen card. */
        .dsp-arlaws { display: grid; gap: 12px; }
        .dsp-arlaw { display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--hairline); border-radius: 12px; padding: 12px 14px; }
        .dsp-arspec { font-size: 22px; color: var(--text-strong); line-height: 1.6; }
        .dsp-arspec-harmattan { font-family: var(--dsp-font-ar); font-weight: 700; }
        .dsp-arspec-amiri { font-family: var(--dsp-font-ar-formal); font-weight: 700; font-size: 25px; }
        .dsp-arspec-digits { font-family: var(--dsp-font-ar); font-size: 18px; }
        .dsp-arspec-quotes { font-family: var(--dsp-font-ar-formal); font-size: 20px; }
        .dsp-arcap { font-family: var(--dsp-font-ar); font-size: 13px; color: var(--text-muted); line-height: 1.7; }

        /* The five faces, each speaking for itself. */
        .dsp-facelist { display: grid; gap: 12px; }
        .dsp-facerow { display: flex; align-items: center; gap: 14px; }
        .dsp-facespec { font-size: 38px; line-height: 1.25; color: var(--text-strong); min-width: 54px; }
        .dsp-f-lit { font-family: var(--dsp-font-display); font-weight: 600; }
        .dsp-f-rdx { font-family: var(--dsp-font-sans); font-weight: 600; }
        .dsp-f-har { font-family: var(--dsp-font-ar); font-weight: 700; }
        .dsp-f-ami { font-family: var(--dsp-font-ar-formal); font-weight: 700; }
        .dsp-f-mono { font-family: var(--dsp-font-mono); font-size: 27px; }
        .dsp-facemeta { margin: 0; font-size: 12px; line-height: 1.5; color: var(--text-muted); }
        .dsp-facemeta b { display: block; color: var(--text-body); }

        /* The developer layer, on the navy terminal pin, so every value is
           the canonical dark set from foundation/dev.css. */
        .dsp-devgrid { display: grid; gap: 18px; }
        .dsp-devpre {
            background: var(--navy-deep); border-radius: 12px; margin: 0;
            font-family: var(--dsp-font-mono); font-size: 11px; line-height: 1.75;
            padding: 12px 10px; overflow-x: auto; color: var(--cream-muted);
        }
        .dsp-devpre span { display: block; white-space: pre; padding: 0 6px; border-radius: 4px; }
        .dsp-devpre i { font-style: normal; display: inline-block; margin-right: 8px; }
        .dsp-d-add { background: #17251B; } .dsp-d-add i { color: #8FAE8B; }
        .dsp-d-drop { background: #2A1D22; } .dsp-d-drop i { color: #E0A5AF; }
        .dsp-d-change { background: #262115; } .dsp-d-change i { color: #E4CA83; }
        .dsp-g-trace { color: #8E8874; }
        .dsp-g-debug { color: #C9BFA6; }
        .dsp-g-info { color: #8F9BC4; }
        .dsp-g-warn { color: #E4CA83; }
        .dsp-g-error { color: #E0A5AF; }
        /* Fatal is the only filled band, exactly as the layer publishes it. */
        .dsp-g-fatal { background: #E0A5AF; color: #241B14; }
        .dsp-devpre .dsp-g-fatal i { color: #241B14; }
        .dsp-g-trace i, .dsp-g-debug i, .dsp-g-info i, .dsp-g-warn i, .dsp-g-error i, .dsp-g-fatal i {
            text-transform: uppercase; font-size: 9px; letter-spacing: .06em; width: 38px;
        }
        .dsp-ansi {
            display: grid; grid-template-columns: repeat(8, 1fr); gap: 5px;
            background: var(--navy-deep); border-radius: 12px; padding: 12px;
        }
        .dsp-ansi i { display: block; aspect-ratio: 1; border-radius: 5px; }
        /* ANSI 0 to 15 from foundation/dev.css, the canonical dark scheme. */
        .dsp-a0 { background: #2A3350; } .dsp-a1 { background: #E0A5AF; } .dsp-a2 { background: #8FAE8B; }
        .dsp-a3 { background: #E4CA83; } .dsp-a4 { background: #8F9BC4; } .dsp-a5 { background: #C9A3CF; }
        .dsp-a6 { background: #83B8B2; } .dsp-a7 { background: #C9BFA6; } .dsp-a8 { background: #8E8874; }
        .dsp-a9 { background: #ECC3CA; } .dsp-a10 { background: #ACC7A8; } .dsp-a11 { background: #F0DDA9; }
        .dsp-a12 { background: #AEB9DA; } .dsp-a13 { background: #DCC0E0; } .dsp-a14 { background: #A3CFC9; }
        .dsp-a15 { background: #F3EAD2; }

        /* All six states, wash, ink and edge per tone, from the published
           state ramps in tokens/colors.css. */
        .dsp-strows { display: grid; gap: 12px; }
        .dsp-strow { display: flex; align-items: flex-start; gap: 10px; }
        .dsp-stx {
            font-size: 11px; font-weight: 600; white-space: nowrap;
            border: 1.5px solid var(--dsp-stx-edge); background: var(--dsp-stx-wash); color: var(--dsp-stx-ink);
        }
        .dsp-stx-positive { --dsp-stx-ink: #4F6B4C; --dsp-stx-wash: #E8E2C9; --dsp-stx-edge: #748A6D; }
        .dsp-stx-info     { --dsp-stx-ink: #41507A; --dsp-stx-wash: #E5DECB; --dsp-stx-edge: #7D8497; }
        .dsp-stx-negative { --dsp-stx-ink: #7A443A; --dsp-stx-wash: #E9DDC6; --dsp-stx-edge: #A27C6D; }
        .dsp-stx-caution  { --dsp-stx-ink: #7A6119; --dsp-stx-wash: #ECE2C7; --dsp-stx-edge: #988246; }
        .dsp-stx-neutral  { --dsp-stx-ink: #6B5A4C; --dsp-stx-wash: #E7DEC6; --dsp-stx-edge: #908171; }
        .dsp-stx-inactive { --dsp-stx-ink: #9B8D7B; --dsp-stx-wash: #E6DCC5; --dsp-stx-edge: #B9AC99; }
        :global(html.theme-dark) .dsp-stx-positive { --dsp-stx-ink: #8FAE8B; --dsp-stx-wash: #2B3440; --dsp-stx-edge: #6E8572; }
        :global(html.theme-dark) .dsp-stx-info     { --dsp-stx-ink: #8F9BC4; --dsp-stx-wash: #2C334A; --dsp-stx-edge: #747EA3; }
        :global(html.theme-dark) .dsp-stx-negative { --dsp-stx-ink: #E0A5AF; --dsp-stx-wash: #343144; --dsp-stx-edge: #997683; }
        :global(html.theme-dark) .dsp-stx-caution  { --dsp-stx-ink: #E4CA83; --dsp-stx-wash: #31333C; --dsp-stx-edge: #8A7E60; }
        :global(html.theme-dark) .dsp-stx-neutral  { --dsp-stx-ink: #C9BFA6; --dsp-stx-wash: #2F3341; --dsp-stx-edge: #827F78; }
        :global(html.theme-dark) .dsp-stx-inactive { --dsp-stx-ink: #586281; --dsp-stx-wash: #252B42; --dsp-stx-edge: #414965; }
        .dsp-strowcap { margin: 3px 0 0; font-size: 11.5px; line-height: 1.5; color: var(--text-muted); }

        /* The extended audit, its flagged pairs, and its two exhibits. */
        .dsp-auditgrid { display: grid; gap: 18px; }
        /* The meters. Narrow first, and the narrow one is not the wide one
           squeezed: the name of what was measured is the whole point of the
           row, so on a phone it takes a line of its own and wraps, with the
           track and the figure beneath it. Cutting those names off with an
           ellipsis, which is what a three-column row does at 340px, leaves a
           reader with a bar and a number and no idea what either is about. */
        .dsp-meterlist { display: grid; gap: 12px; }
        .dsp-meter {
            display: grid; grid-template-columns: 1fr auto;
            align-items: center; gap: 5px 10px;
            font-family: var(--dsp-font-mono); font-size: 11.5px; color: var(--text-muted);
        }
        .dsp-meter dt { grid-column: 1 / -1; }
        .dsp-meter dd { margin: 0; color: var(--text-strong); }
        @media (min-width: 560px) {
            .dsp-meterlist { gap: 9px; }
            .dsp-meter { grid-template-columns: minmax(0, 1fr) minmax(90px, 1.5fr) auto; gap: 12px; }
            /* Back on one line, and now the name is the flexible column, so
               a long check shortens rather than pushing the track off the
               row. It is the only place an ellipsis is the lesser evil. */
            .dsp-meter dt { grid-column: auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        }
        /* A magnitude, so the fill is quiet ink rather than a hue: making it
           green would spend an emphasis on saying twice over what the figure
           and the floor line already say once. */
        .dsp-metertrack {
            position: relative; height: 9px; border-radius: 999px;
            background: color-mix(in srgb, var(--text-muted) 15%, transparent);
        }
        .dsp-metertrack i {
            display: block; height: 100%; border-radius: 999px;
            background: color-mix(in srgb, var(--text-muted) 55%, transparent);
        }
        /* The floor. Caramel, dashed six on four, exactly as the dataviz
           layer publishes its reference line — drawn as a gradient rather
           than a dashed border because a border cannot state its own dash
           lengths, and those two numbers are the published treatment. */
        .dsp-metertrack::after {
            content: ""; position: absolute; left: var(--dsp-floor); top: -3px; bottom: -3px;
            width: 2px; transform: translateX(-1px);
            background: repeating-linear-gradient(to bottom, var(--accent) 0 6px, transparent 6px 10px);
        }
        :global(html.theme-dark) .dsp-metertrack::after {
            background: repeating-linear-gradient(to bottom, var(--caramel-bright) 0 6px, transparent 6px 10px);
        }
        /* The floor's label, standing over the line it names rather than
           sitting in a legend, which is the dataviz layer's own rule. The
           head row mirrors whichever column arrangement the meters are in,
           so the label lands above the track at either size. */
        .dsp-floorhead {
            display: grid; grid-template-columns: 1fr auto;
            gap: 10px; margin-bottom: 5px;
        }
        .dsp-floorhead i {
            grid-column: 1; position: relative; left: var(--dsp-floor);
            transform: translateX(-50%); white-space: nowrap; justify-self: start;
            font-family: var(--dsp-font-mono); font-style: normal; font-size: 9.5px;
            color: var(--dsp-accent-ink);
        }
        @media (min-width: 560px) {
            .dsp-floorhead { grid-template-columns: minmax(0, 1fr) minmax(90px, 1.5fr) auto; gap: 12px; }
            .dsp-floorhead i { grid-column: 2; }
        }
        /* The measured pairings. The two colours inside the box are authored
           and never move with the theme, because the box holds exactly the
           pair that was measured. The hairline around it is chrome rather
           than part of the specimen, and it has to be there: a cream-ground
           pairing drawn on a cream pin has no visible edge at all in light
           mode, and an exhibit you cannot see the extent of proves nothing.
           Same hairline the palette chips take, for the same reason. */
        .dsp-pairs { display: grid; gap: 8px; }
        .dsp-pair { display: flex; align-items: center; gap: 10px; }
        .dsp-pairink { flex: 1; border: 1px solid var(--hairline); border-radius: 8px; padding: 9px 12px; font-size: 12.5px; }
        .dsp-pairratio { font-family: var(--dsp-font-mono); font-size: 11px; color: var(--text-muted); }
        /* The simulation rows. The chips are the chart pin's own classes, so
           the two pins can never publish different sevens. */
        .dsp-sims { display: grid; gap: 7px; }
        .dsp-simrow { display: flex; align-items: center; gap: 12px; }
        .dsp-simlbl {
            font-family: var(--dsp-font-mono); font-size: 9.5px; letter-spacing: .08em;
            text-transform: uppercase; color: var(--text-muted); width: 96px; flex: none;
        }
        .dsp-simchips { display: flex; gap: 4px; flex: 1; }
        .dsp-simchips i { flex: 1; height: 22px; border-radius: 4px; }
        .dsp-cvd-deuteranopia { filter: url(#dsp-cvd-deuteranopia); }
        .dsp-cvd-protanopia { filter: url(#dsp-cvd-protanopia); }
        .dsp-flags { display: grid; gap: 10px; }
        .dsp-flag {
            margin: 0; font-size: 12px; line-height: 1.55; color: var(--text-muted);
            border-left: 3px solid color-mix(in srgb, var(--accent) 45%, transparent); padding-left: 10px;
        }
        .dsp-flag b { display: block; color: var(--text-body); font-family: var(--dsp-font-mono); font-size: 11px; }

        /* The motion stage. 420 and 220 are the published numbers for the two
           duration roles, and the curve is the system's one standard ease. */
        .dsp-stage { display: flex; align-items: center; gap: 18px; border: 1px solid var(--hairline); border-radius: 14px; padding: 18px; }
        .dsp-stagecard {
            width: 74px; height: 54px; border-radius: 10px; background: var(--surface);
            border: 1px solid var(--hairline); box-shadow: var(--shadow-soft);
            display: grid; place-items: center;
        }
        .dsp-stageglyph { font-family: var(--dsp-font-display); font-weight: 600; font-size: 20px; color: var(--text-strong); }
        .dsp-stagechip { width: 44px; height: 20px; border-radius: 999px; background: #E7DEC6; }
        :global(html.theme-dark) .dsp-stagechip { background: #2F3341; }
        .dsp-stage.is-playing .dsp-stagecard { animation: dsp-stagerise 420ms cubic-bezier(.22, .61, .36, 1) both; }
        .dsp-stage.is-playing .dsp-stagechip { animation: dsp-stageflip 220ms cubic-bezier(.22, .61, .36, 1) 520ms both; }
        @keyframes dsp-stagerise { from { opacity: 0; transform: translateY(14px); } }
        @keyframes dsp-stageflip { to { background: var(--accent); } }
        .dsp-replay {
            cursor: pointer; margin-left: auto; font-family: inherit;
            font-size: 12px; font-weight: 600; border: 1.5px solid var(--text-strong);
            background: transparent; color: var(--text-strong); border-radius: 999px; padding: 7px 14px;
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state);
        }
        .dsp-replay:hover { background: var(--text-strong); color: var(--surface); }

        /* The expanded panels' wide arrangements, gathered in one query. */
        @media (min-width: 700px) {
            .dsp-marks { grid-template-columns: repeat(3, 1fr); }
            .dsp-jobs { grid-template-columns: repeat(2, 1fr); }
            .dsp-arlaws { grid-template-columns: repeat(2, 1fr); }
            .dsp-strows { grid-template-columns: repeat(2, 1fr); }
            .dsp-pairs { grid-template-columns: repeat(2, 1fr); }
        }
        @media (min-width: 1000px) {
            .dsp-jobs { grid-template-columns: repeat(5, 1fr); }
            .dsp-strows { grid-template-columns: repeat(3, 1fr); }
            .dsp-devgrid { grid-template-columns: 1fr 1.25fr 1fr; }
            /* The meters need the wider half: they carry a name, a track and
               a figure, where the flagged pairs carry sentences only. */
            .dsp-auditgrid { grid-template-columns: 1.4fr 1fr; }
            .dsp-facelist { grid-template-columns: repeat(5, 1fr); }
            .dsp-facerow { flex-direction: column; align-items: flex-start; gap: 6px; }
        }

        /* ---- The closing ---- */
        /* Half the draw, and only for this heading. global.css wipes a
           .marker-wash over 420ms once the observer marks it, which the
           masthead can afford: it is drawn on load and the reader arrives with
           it, so the slow stroke is the reader watching a mark being made. This
           one is triggered under the fold, so it is FIRST seen mid-stroke, and
           a mark caught half made does not read as a mark being made. It reads
           as one that came out wrong. The masthead keeps the site's own timing. */
        #closing .marker-wash::before { transition-duration: 210ms; }
        .dsp-closing { font-family: var(--dsp-font-display); font-size: clamp(30px, 7vw, 56px); }
        .dsp-closingsub { margin: 14px auto 26px; font-size: 14.5px; color: var(--text-muted); max-width: 48ch; line-height: 1.65; }
        .dsp-btn {
            font-weight: 600; font-size: 14px; border-radius: 999px; padding: 12px 26px;
            cursor: pointer; display: inline-block; list-style: none;
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state), border-color var(--dsp-dur-state), transform var(--dsp-dur-state);
        }
        .dsp-btn:active { transform: scale(.97); }
        /* Where this page departs from the site's own chrome, on purpose, and
           the note the other two departures point at. global.css sets
           .btn-primary to --accent under --on-accent, which measures 3.07:1 in
           light and 3.79:1 in dark — the site's 3:1 button treatment, and short
           of the 4.5:1 a 14px label wants. Five pins up, this page publishes an
           audit that says contrast passes in light and in dark. A page cannot
           print that claim and then set its own loudest control below the bar
           the claim is about.

           So the label is the page's darkest ink instead, and one rule covers
           both modes because --accent does not flip: 4.59:1 either side. All
           three of the page's accent fills take that same pair — this button,
           the light switch and the mirror's flip — so the fork is one decision
           applied consistently, not a button that disagrees with its
           neighbours. The site-wide pair is deliberately left alone for now and
           is the planned site-adjustment pass's to reconcile. */
        .dsp-btn-pri { background: var(--accent); border: 1.5px solid var(--accent); color: var(--choc-ink); }
        /* Both buttons hover into the same inversion: the page's ink becomes
           the ground and the page's ground becomes the ink, which is one rule
           for both modes because both halves flip together. 14.1:1 in light and
           13.6:1 in dark, for each of them.

           The primary needs its own label here rather than inheriting the rest
           state's: the hover ground IS --text-strong, and in light that is the
           same chocolate as the ink above, which would leave 1:1. Naming
           --cream instead would read in light and paint cream on cream in dark,
           at 1:1 the other way round. Only the ground token says it once. */
        .dsp-btn-pri:hover { background: var(--text-strong); border-color: var(--text-strong); color: var(--surface); }
        .dsp-btn-sec { background: transparent; border: 1.5px solid var(--text-strong); color: var(--text-strong); }
        .dsp-btn-sec:hover { background: var(--text-strong); color: var(--surface); }
        /* Open rests where hover points, so the control admits it is holding
           the panel. Same three values as the hover above, which cannot fight
           it while both apply. */
        .dsp-contract[open] .dsp-btn-pri {
            background: var(--text-strong); border-color: var(--text-strong); color: var(--surface);
        }
        .dsp-contract summary::-webkit-details-marker { display: none; }
        /* The panel and its summary are one element, so they cannot sit beside
           the proofs button and underneath it at the same time. Open, the
           disclosure takes the row for itself and centres its own summary, and
           the proofs button wraps below the panel — which is the order the copy
           wants anyway: open the contract, read it, then be offered the proofs.
           Closed, the two controls are a centred pair at every width.

           This leans on the flex-wrap utility on the row and does not work
           without it. A basis of 100% only pushes the proofs button onto a line
           of its own if the row is allowed to make one; on a row that cannot
           wrap, the two controls stay put and share the width, and the open
           panel is squeezed into whatever is left of it.

           display: contents on the disclosure looks like the shortcut here,
           because it would drop summary and panel straight into the row and let
           each take its own line. Do not reach for it: the box it removes is
           the one current engines hang the closed panel's hiding off, so the
           contract would be on show before anyone asked for it. */
        .dsp-contract[open] { flex-basis: 100%; text-align: center; }
        .dsp-contractbody {
            max-width: 640px; margin: 20px auto 0; text-align: start;
            font-size: 13px; line-height: 1.65; color: var(--text-muted);
            border-top: 1px solid var(--hairline); padding-top: 16px;
            animation: dsp-unfold .35s var(--dsp-ease);
        }
        .dsp-contractbody p { margin: 0 0 10px; }
        .dsp-contractbody strong { color: var(--text-body); }

        /* global.css caps every animation and transition at 1ms under reduced
           motion, which finishes a one-shot and makes an endless one flicker
           instead of stopping. The two endless ones on this page are named off
           here, the same escape hatch .marquee-track takes.

           The rest of the page's motion, audited against that clamp:
           dsp-unfold on both disclosure panels is a one-shot and the clamp
           lands it at its end state; the pin lift, the pin dim, the pindot and
           spine-dot scales, the annotation rule's stretch and the chevron's
           quarter turn are all state, so the clamp keeps the state and drops
           the travel; the flip button's hover swell and the buttons' press dip
           are the same clamped category; the mirror's dip is not clamped but
           skipped, the script branching on the same query and flipping with no
           fade at all; the expanded panels take the same route, the script
           skipping the measured glide and the rise entirely so open and shut
           simply land, and asking for an instant scroll to the podium;
           the motion stage's two one-shots clamp to their end states, which
           is the very law that stage exists to demonstrate; and the proofs
           scroll asks for 'instant' rather than letting html's smooth
           scroll-behavior answer. Nothing here travels under reduced motion. */
        @media (prefers-reduced-motion: reduce) {
            .dsp-bubble, .dsp-term .dsp-cursor { animation: none; }
        }
    </style>

    <script>
        const bindMirror = () => {
            const mirror = document.getElementById('dsp-mirror');
            const btn = document.querySelector<HTMLButtonElement>('[data-mirror-flip]');
            if (!mirror || !btn || btn.dataset.bound) return;
            // Per-element rather than per-window: View Transitions swap in a new
            // button on every navigation back to this page, so the flag has to
            // live on the element that carries the listener. The document
            // listener below is registered once, when this module first runs.
            btn.dataset.bound = '1';
            const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            // Read once, from the same custom property the fade is written in, so
            // the wait can never drift from the animation it is waiting on.
            const dip = parseFloat(getComputedStyle(mirror).getPropertyValue('--dsp-dur-flip')) * 1000 || 180;
            btn.addEventListener('click', () => {
                // A dip already in flight owns the card. Without this, a fast
                // second click flips the columns while they are still faded out
                // and the reader sees them strobe.
                if (mirror.classList.contains('is-swapping')) return;
                const flip = () => {
                    mirror.classList.toggle('is-flipped');
                    const flipped = mirror.classList.contains('is-flipped');
                    btn.setAttribute('aria-pressed', String(flipped));
                    // Task 8's analytics listens for pinboard:flip. Emitted here
                    // rather than measured there so the reading direction the
                    // event reports is the one the card actually settled on.
                    document.dispatchEvent(new CustomEvent('pinboard:flip', {
                        detail: {to: flipped ? 'to-ar' : 'to-en'}
                    }));
                };
                if (reduced()) { flip(); return; }
                mirror.classList.add('is-swapping');
                setTimeout(() => {
                    // A navigation mid-dip detaches this card. Firing anyway would
                    // announce a flip on whatever page the reader is on instead.
                    if (!mirror.isConnected) return;
                    flip();
                    mirror.classList.remove('is-swapping');
                }, dip);
            });
        };

        // Set by bindProofs for the length of one synthetic click, read and
        // cleared by the rail's own handler. Task 8 wants to tell a stop the
        // reader chose in the rail apart from the same stop arrived at through
        // the closing band, and the click itself carries nothing to say which:
        // a synthetic click is indistinguishable from a real one by design.
        // Module scope rather than a data attribute so nothing about it is
        // visible in the DOM, and the two writes are one synchronous step apart.
        let viaProofs = false;

        // Assigned further down where the expansion is wired, called by the
        // rail: a stop filter and an opened pin answer different questions,
        // so choosing a stop shuts the panel first.
        let closeOpenPin: () => void = () => {};

        const bindRail = () => {
            const board = document.getElementById('dsp-board');
            if (!board || board.dataset.bound) return;
            board.dataset.bound = '1';
            const railStops = [...document.querySelectorAll<HTMLButtonElement>('[data-rail-stop]')];
            const pinEls = [...board.querySelectorAll<HTMLElement>('[data-pin-stop]')];
            let filtering = 'all';

            // The pressed state goes with the highlight rather than being set
            // only on click: these buttons are an exclusive group, so whichever
            // one the rail is currently showing as current is the one a screen
            // reader should hear as pressed.
            const light = (id: string) => railStops.forEach((stop) => {
                const on = stop.dataset.railStop === id;
                stop.classList.toggle('is-on', on);
                stop.setAttribute('aria-pressed', String(on));
            });

            railStops.forEach((stop) => stop.addEventListener('click', () => {
                closeOpenPin();
                filtering = stop.dataset.railStop ?? 'all';
                // Read and cleared on every click, including the ones that do
                // not report, so a flag can never outlive the click it was set
                // for and colour the next one.
                const via = viaProofs ? 'proofs' : 'rail';
                viaProofs = false;
                light(filtering);
                pinEls.forEach((pinEl) => {
                    pinEl.classList.toggle('is-dim', filtering !== 'all' && pinEl.dataset.pinStop !== filtering);
                });
                if (filtering !== 'all') {
                    // Task 8's analytics listens for pinboard:focus. Only a real
                    // narrowing is reported: going back to all pins is leaving a
                    // stop rather than choosing one.
                    document.dispatchEvent(new CustomEvent('pinboard:focus', {detail: {stop: filtering, via}}));
                }
            }));

            // Hover and keyboard focus drive the rail, never scroll: a packed
            // board has no single vertical order, so scroll offset lies.
            const track = (pinEl: HTMLElement) => {
                // A chosen stop owns the rail until another one is chosen.
                if (filtering !== 'all') return;
                light(pinEl.dataset.pinStop ?? 'all');
            };
            pinEls.forEach((pinEl) => {
                pinEl.addEventListener('mouseenter', () => track(pinEl));
                pinEl.addEventListener('focusin', () => track(pinEl));
            });
            board.addEventListener('mouseleave', () => { if (filtering === 'all') light('all'); });
        };

        const bindProofs = () => {
            const link = document.querySelector<HTMLAnchorElement>('[data-proofs-stop]');
            if (!link || link.dataset.bound) return;
            link.dataset.bound = '1';
            link.addEventListener('click', (event) => {
                // The href is what the page does with no script; this handler is
                // the upgrade and takes the click over completely. Left to run,
                // the browser's own jump would land first and fight the scroll
                // below, and put #dsp-railboard in the address bar on the way.
                event.preventDefault();
                // Read once and shared by both scrolls below. 'instant' rather
                // than 'auto': 'auto' does not mean "no animation", it means "go
                // and ask the computed styles", and global.css sets
                // scroll-behavior: smooth on html.
                const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
                // Reuse the rail: a synthetic click gets the dim, the is-on state
                // and the analytics event from one mechanism instead of three.
                // The rail stops carry no data-cta, so the cta_click listener
                // never sees the synthetic click and this control's own click is
                // still counted exactly once.
                const stop = document.querySelector<HTMLButtonElement>(`[data-rail-stop="${link.dataset.proofsStop}"]`);
                if (stop) {
                    // The page moves, so the keyboard moves with it: focus lands
                    // on the stop this button just chose, and the next Tab
                    // carries on into the board instead of resuming down here in
                    // the closing band, a screen away from what the reader was
                    // sent to look at. preventScroll because the scroll below is
                    // the considered one — focus would otherwise jump first, with
                    // none of the clearance and none of the motion setting.
                    // Nothing listens for focus on a rail stop, so this moves the
                    // caret and nothing else.
                    stop.focus({preventScroll: true});
                    // Only ever true across the click on the next line.
                    viaProofs = true;
                    stop.click();
                    // Under 900px the rail is a row that scrolls sideways, and
                    // the chosen chip can sit outside its window — focused,
                    // lit, and off the side of the screen. inline: 'center'
                    // brings it in; block: 'nearest' asks the page for the
                    // least vertical movement it can, and the scroll below then
                    // supersedes that on the same box rather than fighting it,
                    // because a second scroll aborts the first. Above 900px the
                    // row has no overflow to scroll and this does nothing.
                    stop.scrollIntoView({block: 'nearest', inline: 'center', behavior});
                }
                document.getElementById('dsp-railboard')?.scrollIntoView({behavior, block: 'start'});
            });
        };

        // ---- The expansion ----
        // Everything below is delegated from the document and registered once,
        // when this module first runs: View Transitions swap every pin, and a
        // listener that looks its elements up per click needs no rebinding and
        // no guards. On any other page the selectors simply never match.
        const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const openPin = () => document.querySelector<HTMLElement>('.dsp-pin.is-open');

        // Restarting an animation needs the styles flushed between the
        // removal and the re-add, which is what reading the width forces.
        const restart = (el: HTMLElement, name: string) => {
            el.classList.remove(name);
            void el.offsetWidth;
            el.classList.add(name);
        };
        const playStage = (stage: HTMLElement) => restart(stage, 'is-playing');
        const rise = (pinEl: HTMLElement) => { if (!reducedMotion()) restart(pinEl, 'is-rising'); };

        const setOpen = (pinEl: HTMLElement, open: boolean) => {
            pinEl.classList.toggle('is-open', open);
            pinEl.querySelector<HTMLButtonElement>('.dsp-open')?.setAttribute('aria-expanded', String(open));
            const panel = pinEl.querySelector<HTMLElement>('.dsp-exp');
            if (panel) panel.hidden = !open;
            // The motion stage plays itself when its row opens, so the demo
            // is seen without hunting for the replay control.
            const stage = open ? panel?.querySelector<HTMLElement>('[data-motion-stage]') : null;
            if (stage) playStage(stage);
        };

        // A pin comes home in front of the first pin ordered after it. The
        // board's own children are the register: whatever is still on the
        // board is in the entry's order, so the first higher index is the
        // pin this one belongs before.
        const sendHome = (pinEl: HTMLElement) => {
            const board = document.getElementById('dsp-board');
            if (!board) return;
            const index = Number(pinEl.dataset.pinIndex);
            const next = [...board.children].find(
                (el) => Number((el as HTMLElement).dataset.pinIndex) > index
            );
            board.insertBefore(pinEl, next ?? null);
        };

        // The measured glide: record where every pin is, let the board
        // repack, then let each pin travel from its old place to its new one
        // on its own transition.
        //
        // Page coordinates rather than viewport ones, because the page
        // itself moves during this: opening scrolls to the podium and
        // closing corrects for the panel that folded away above. A viewport
        // delta would fold that scrolling into every pin's travel and send
        // the whole board sliding.
        //
        // `jumpers` are the pins changing places between the board and the
        // podium. They are left out of the travel on purpose: a pin at the
        // foot of the board would otherwise fly up through everything above
        // it, which is exactly the trip the page is already making. They
        // rise where they land instead, and the pins that stay put carry the
        // continuity by closing the gap.
        const glide = (mutate: () => void, jumpers: Set<HTMLElement>, settle?: () => void) => {
            const els = [...document.querySelectorAll<HTMLElement>('.dsp-pin')];
            if (reducedMotion()) { mutate(); settle?.(); return; }
            const first = new Map(els.map((el) => {
                const box = el.getBoundingClientRect();
                return [el, {x: box.left + window.scrollX, y: box.top + window.scrollY}];
            }));
            mutate();
            settle?.();
            els.forEach((el) => {
                const was = first.get(el);
                if (!was || jumpers.has(el)) return;
                const box = el.getBoundingClientRect();
                const dx = was.x - (box.left + window.scrollX);
                const dy = was.y - (box.top + window.scrollY);
                if (!dx && !dy) return;
                el.style.transitionProperty = 'none';
                el.style.transform = `translate(${dx}px, ${dy}px)`;
                // Two frames: the first paints the inverted state, the second
                // releases it so the pin's own transition carries it home.
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    el.style.transitionProperty = '';
                    el.style.transform = '';
                }));
            });
        };

        const showPin = (pinEl: HTMLElement) => {
            const podium = document.getElementById('dsp-podium');
            if (!podium) return;
            const leaving = openPin();
            const hadCaret = pinEl.contains(document.activeElement);
            // Both pins that change places are jumpers, so a swap reads as
            // one repack rather than as two moves fighting each other.
            const jumpers = new Set([pinEl]);
            if (leaving && leaving !== pinEl) jumpers.add(leaving);
            glide(() => {
                if (leaving && leaving !== pinEl) { setOpen(leaving, false); sendHome(leaving); }
                podium.appendChild(pinEl);
                setOpen(pinEl, true);
            }, jumpers);
            jumpers.forEach(rise);
            // Moving an element re-parents it, and the caret does not always
            // survive the trip. Restored only if it was inside this pin to
            // begin with, so a mouse click never drags focus about.
            if (hadCaret) pinEl.querySelector<HTMLButtonElement>('.dsp-open')?.focus({preventScroll: true});
            // The expand event is the disclosure_open signal's carrier now
            // that the details elements are gone. Same item labels.
            const label = pinEl.querySelector<HTMLElement>('.dsp-open')?.dataset.pinOpen || '';
            document.dispatchEvent(new CustomEvent('pinboard:expand', {detail: {item: label}}));
            // The page goes to the panel while the board settles behind it,
            // so a pin opened from the foot of the board can never open out
            // of sight. The podium carries the same clearance token every
            // anchor target on the site reads.
            podium.scrollIntoView({block: 'start', behavior: reducedMotion() ? 'instant' : 'smooth'});
        };

        const hidePin = () => {
            const pinEl = openPin();
            const board = document.getElementById('dsp-board');
            if (!pinEl || !board) return;
            const caret = document.activeElement;
            const hadCaret = !!caret && pinEl.contains(caret);
            // Whether the browser is drawing that caret, which is the honest
            // test for "someone is working this by keyboard". It decides
            // whether the page is allowed to follow the pin home: a keyboard
            // reader must be able to see where focus went, and a reader who
            // clicked a control with a mouse must not be carted off after it.
            const byKeyboard = hadCaret && (caret as HTMLElement).matches(':focus-visible');
            // Where the board sits on screen before the panel folds away.
            const before = board.getBoundingClientRect().top;
            glide(() => {
                setOpen(pinEl, false);
                sendHome(pinEl);
            }, new Set([pinEl]), () => {
                // The panel is above the board, so folding it pulls the whole
                // board up by its height and the reader is suddenly looking
                // at something else. Putting the board's own top back where
                // it was leaves the view exactly as it was found: closing
                // takes the panel away and moves nothing else. Instant on
                // purpose, this is a correction rather than a journey.
                const after = board.getBoundingClientRect().top;
                if (after !== before) window.scrollBy({top: after - before, behavior: 'instant'});
            });
            rise(pinEl);
            if (hadCaret) {
                pinEl.querySelector<HTMLButtonElement>('.dsp-open')?.focus({preventScroll: true});
                // 'nearest' asks for the least movement there is, so a pin
                // that came home on screen is left exactly where it is.
                if (byKeyboard) pinEl.scrollIntoView({block: 'nearest', behavior: reducedMotion() ? 'instant' : 'smooth'});
            }
        };

        const togglePin = (pinEl: HTMLElement) => {
            if (pinEl.classList.contains('is-open')) hidePin();
            else showPin(pinEl);
        };

        closeOpenPin = hidePin;

        document.addEventListener('click', (event) => {
            if (!(event.target instanceof Element)) return;
            const replay = event.target.closest<HTMLElement>('[data-motion-replay]');
            if (replay) {
                const stage = replay.closest<HTMLElement>('[data-motion-stage]');
                if (stage) playStage(stage);
                return;
            }
            const openBtn = event.target.closest<HTMLElement>('.dsp-open');
            if (openBtn) {
                const pinEl = openBtn.closest<HTMLElement>('.dsp-pin');
                if (pinEl) togglePin(pinEl);
                return;
            }
            // The card itself is the invitation: a click anywhere on a pin
            // that has a panel to open, and is not on some other control,
            // opens it. Shutting stays with the labelled control, Esc and the
            // rail, so selecting text in an open panel never slams it shut.
            const pinEl = event.target.closest<HTMLElement>('.dsp-pin');
            if (!pinEl || pinEl.classList.contains('is-open')) return;
            if (event.target.closest('a, button, details, summary')) return;
            if (!pinEl.querySelector('.dsp-exp')) return;
            togglePin(pinEl);
        });

        // Escape shuts the panel. The caret is not chased here: hidePin
        // already hands it back to the control that reopens the pin, and only
        // follows it home when the browser says a keyboard is driving.
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && openPin()) hidePin();
        });

        // One listener for the page, fanning out to the sections. Each part
        // carries its own guard, so a section already wired after a View
        // Transitions swap is skipped without skipping the others. bindRail's
        // guard is the board rather than the rail it also wires: the two arrive
        // and are replaced together, so the board standing guard for the pair
        // is one flag on one element instead of two that could disagree.
        const bindPinboard = () => { bindMirror(); bindRail(); bindProofs(); };
        document.addEventListener('astro:page-load', bindPinboard);
    </script>

    <ProjectAnalytics/>
</BaseLayout>
