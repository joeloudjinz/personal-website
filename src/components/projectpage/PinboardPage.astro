---
// The pinboard template: the Joe Inz Design System showcase. Layout and
// behavior live here; every user-visible string comes from the entry.
// Copy rules for entry strings: no em-dashes, no semicolons, human register.
//
// Comments in this file are scanned as raw bytes by Tailwind — see the note in
// tailwind.config.mjs before writing one.
import BaseLayout from '@src/layouts/BaseLayout.astro';
import ProjectAnalytics from '@src/components/ProjectAnalytics.astro';
import {splitWash, type PinboardEntry} from '@src/utils/projectPages';

interface Props {
    page: PinboardEntry;
}

const {page} = Astro.props;
// Destructured here so the sections read their copy off one line rather than
// reaching into page.data each time.
const {seo, projectName, masthead, mirror, railCaption, railNote, allLabel, stops, pins, closing} = page.data;

const canonical = `https://${page.data.subdomain}/`;

// Same wash contract as the band pages, split by the same shared helper. Null
// is unreachable (the schema enforces wash-in-heading) but the render guards it
// anyway, exactly as BandPage does.
const mastheadWash = splitWash(masthead.heading, masthead.wash);
const closingWash = splitWash(closing.heading, closing.wash);
---

<BaseLayout title={seo.title} description={seo.description ?? mirror.en.body} gradient='warm'
            keywords={seo.keywords?.join(', ')} imageAlt={seo.imageAlt}
            canonical={canonical} chrome='subdomain' projectName={projectName}>
    {/* Page-only faces. A <link> in the body is valid HTML and keeps the fonts
        off every other page. The site's Fraunces/Inter still load via BaseHead
        for the shared chrome.

        Four of the system's five faces, and the fifth is left out on purpose:
        Amiri is the quotation register, and nothing on this page speaks in it.
        The board's own quote pin is a field note in the sharp register, not a
        quotation. "Five faces" in the copy describes the system, not what this
        page downloads — the day a pin quotes something, Amiri joins this list. */}
    <link rel='stylesheet'
          href='https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,500&family=Readex+Pro:wght@400;500;600;700&family=Harmattan:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap'/>

    {/* Without a script this page has no reveal to wait for. global.css starts
        .reveal at opacity 0 and only the observer in BaseLayout adds
        .is-visible, so the mirror, all nine pins and the whole closing band
        would stay blank — nearly the entire page. .marker-wash is the same
        observer's other client: its bar starts at scaleX(0), so both washed
        headings would lose their marking. Both are handed their finished state
        here instead.

        The masthead's .cascade is deliberately NOT in this list. Its children
        are hidden the same way but un-hidden by a CSS animation that ends at
        opacity 1 and holds it (fill-mode forwards), which needs no script at
        all — naming it here, and turning that animation off, is the one thing
        that WOULD leave it unpainted. ("unpainted" rather than the obvious
        utility name on purpose: Tailwind scans this file as plain text, so
        spelling that name here emits its rule into the shared bundle even
        though no element ever carries the class. See tailwind.config.mjs.)

        is:inline keeps this where it is written: an Astro <style> is otherwise
        hoisted into the page's stylesheet, where it would apply to everyone.
        A style element in a body noscript is technically non-conforming (the
        fonts link above IS body-legal, this is the case that is not), but every
        engine honours it and BaseLayout offers no head slot to put it in.

        What stays inert without a script, accepted by the spec: the rail stops
        and the mirror flip do nothing, the theme stays light, and the proofs
        control falls back to its own fragment jump. The content all reads. */}
    <noscript>
        <style is:inline>
            .reveal { opacity: 1 !important; transform: none !important; }
            .marker-wash::before { transform: none !important; }
        </style>
    </noscript>

    <div class='dsp'>
        <header class='shell pt-[72px] pb-[8px]'>
            <div class='flex flex-wrap items-end justify-between gap-7'>
                <div class='cascade'>
                    <p class='kicker mb-6'>{masthead.kicker}</p>
                    <h1 class='dsp-display font-semibold text-strong tracking-[-0.015em] leading-[1.05]'>
                        {mastheadWash
                            ? <>{mastheadWash.before}<span class='marker-wash whitespace-nowrap'>{mastheadWash.washed}</span>{mastheadWash.after}</>
                            : masthead.heading}
                    </h1>
                </div>
                <div class='flex flex-col items-end gap-3 pb-[10px]'>
                    {/* A second control on the site's ONE theme mechanism, not a
                        second mechanism. The class is the whole wiring: the
                        handler in Header.astro is delegated on the document and
                        acts on anything matching .theme-toggle, so this button
                        gets the class flip, the localStorage write and the
                        aria-pressed sync for free, and the two controls cannot
                        drift apart because there is only one of them.

                        Both labels are rendered and CSS picks one off the html
                        class. No script writes this text, which is what makes it
                        right on the first paint of a dark-mode load — a label
                        set by JS would say "Turn the lights off" until the
                        handler caught up. Hiding with display also keeps the
                        accessible name honest: only the shown label is in it. */}
                    <button class='dsp-modebtn theme-toggle' type='button'>
                        <span class='dsp-lbl-to-dark'>{masthead.lightSwitch.toDark}</span>
                        <span class='dsp-lbl-to-light'>{masthead.lightSwitch.toLight}</span>
                    </button>
                    {/* .stack-line paints the middle dot at the START of each fact
                        after the first, so a dot can never wrap onto a line by
                        itself, and it draws them in caramel. Same run BandPage
                        gives its closing facts; the mono and the 11px are this
                        page's register and stay in .dsp-facts. */}
                    <p class='stack-line dsp-facts justify-end'>
                        {masthead.facts.map((fact) => <span class='stack-tag'>{fact}</span>)}
                    </p>
                </div>
            </div>
        </header>
        {/* The featured element: one idea in two scripts, and the control
            between them swaps which one is read first.

            Each side pins its own dir. The card's flow direction is what the
            flip changes — .is-flipped sets direction: rtl on the card, which
            reverses the two grid tracks — and without dir='ltr' the English
            side would inherit that flow and set its own sentences right to
            left, moving every full stop to the wrong end. Direction of flow
            and direction of script are two different questions here, and the
            markup answers them separately. */}
        {/* The id's one reader is ProjectAnalytics' section_view observer, and
            the same is true of the closing section's. The board between them is
            deliberately not in that funnel: rail_focus is its signal, and a
            section_view of the board would restate what that event already
            answers. */}
        <section class='shell mt-6 reveal' id='mirror'>
            <div class='dsp-mirror relative grid grid-cols-1 min-[860px]:grid-cols-2 overflow-hidden'
                 id='dsp-mirror'>
                {/* The one element here that deliberately pins no dir: its
                    "EN ⇄ عربي" label reverses along with the card, which is the
                    whole point of it.

                    Named for the action, not for the scripts, and the state
                    rides aria-pressed — the same label-stable pattern the
                    header's theme toggle uses. Hard-coded false because the
                    flip is never restored on load, so English-first is always
                    where a fresh page starts. */}
                <button class='dsp-flipbtn' type='button' data-mirror-flip
                        aria-pressed='false' aria-label='EN عربي, switch the reading direction'>
                    EN <span aria-hidden='true'>⇄</span> <b lang='ar'>{mirror.flipLabel}</b>
                </button>
                <div class='dsp-mside px-7 py-12 min-[860px]:px-16 min-[860px]:py-14' dir='ltr'>
                    <p class='kicker mb-3'>{mirror.en.kicker}</p>
                    <h2 class='dsp-mhead'>{mirror.en.heading}</h2>
                    <p class='dsp-mbody'>{mirror.en.body}</p>
                </div>
                <div class='dsp-mside dsp-mside-ar px-7 py-12 min-[860px]:px-16 min-[860px]:py-14'
                     dir='rtl' lang='ar'>
                    <p class='kicker dsp-kicker-ar mb-3'>{mirror.ar.kicker}</p>
                    <h2 class='dsp-mhead dsp-mhead-ar'>{mirror.ar.heading}</h2>
                    <p class='dsp-mbody dsp-mbody-ar'>{mirror.ar.body}</p>
                </div>
            </div>
        </section>
        {/* The rail and the board. The rail does two jobs at once: it follows
            whichever pin the pointer or the keyboard is on, and a click on a
            stop pins that highlight and dims every pin belonging elsewhere.
            Both halves are bindRail below.

            A plain stack under 900px and a two-track layout above it, rather
            than a two-track layout that narrows: the rail is a different
            object at each size — a row of chips that scrolls sideways, and a
            vertical spine with a dot per stop — and the narrow one has to be
            free of the wide one's row to pin itself under the site's bar. */}
        {/* The proofs button scrolls to this wrapper rather than to the board
            inside it, so the rail lands on screen with the stop it just chose
            already lit — under 900px the rail is a row ABOVE the board, and
            stopping at the board's own top edge would leave it overhead.

            The clearance is the token every anchor target on the site reads,
            because this is the same question: how far below the sticky bar a
            jumped-to thing has to start. See --anchor-offset in global.css. */}
        <div class='shell mt-9 pb-8 block min-[900px]:grid min-[900px]:grid-cols-[216px_1fr] min-[900px]:gap-9 scroll-mt-[var(--anchor-offset)]'
             id='dsp-railboard'>
            {/* Named by the page's own caption rather than by a string written
                in here, so project #2's rail announces itself in its own words.
                The caption is drawn only at the wide layout and the name
                survives that: text referenced by aria-labelledby is read out
                whether or not it is on screen. */}
            <nav class='dsp-rail sticky self-start z-10 mb-6 min-[900px]:mb-0' aria-labelledby='dsp-railcap'>
                <p class='dsp-railcap hidden mb-2.5 ml-5 min-[900px]:block' id='dsp-railcap'>{railCaption}</p>
                {/* An exclusive filter group, so the pressed state sits on each
                    stop rather than on the row. Authored here as well as kept
                    in step by the script: with no JS the rail is still a set of
                    buttons that say which one is current. */}
                <div class='dsp-railline flex gap-2 overflow-x-auto min-[900px]:flex-col min-[900px]:gap-0 min-[900px]:overflow-visible'>
                    <button class='dsp-stop is-on relative shrink-0 whitespace-nowrap text-left' type='button'
                            data-rail-stop='all' aria-pressed='true'>{allLabel}</button>
                    {stops.map((stop) => (
                        <button class='dsp-stop relative shrink-0 whitespace-nowrap text-left' type='button'
                                data-rail-stop={stop.id} aria-pressed='false'>{stop.label}</button>
                    ))}
                </div>
                <p class='dsp-railnote hidden mt-4 ml-5 min-[900px]:block'>{railNote}</p>
            </nav>

            <div class='dsp-board columns-1 gap-5 min-[580px]:columns-2 min-[900px]:columns-3' id='dsp-board'>
                {pins.map((pin, index) => (
                    /* The tab stop is what lets the rail follow the keyboard,
                       and it is also what would put every pin in a screen
                       reader's list unnamed — so each is named by its own
                       label. No role: ARIA allows none of the grouping roles
                       on an article, and the name alone conforms, so a pin
                       reads "02 · the palette, article" and the Arabic pin
                       announces itself in Arabic. */
                    <article class:list={['dsp-pin', 'reveal', 'relative', 'inline-block', 'w-full', 'mb-5', 'p-6', 'break-inside-avoid',
                                          {'dsp-pin-dark': pin.kind === 'quote' || pin.kind === 'terminal'}]}
                             data-pin-stop={pin.stop} tabindex='0' aria-labelledby={`dsp-pin-${index}`}>
                        <span class='dsp-pindot absolute' aria-hidden='true'></span>
                        {/* The Arabic pin labels itself in Arabic, so the label
                            carries its own script and its own direction. Every
                            other pin's label is left alone rather than marked
                            'en': the page is already in English. */}
                        <span class:list={['dsp-lbl', 'block', 'mb-3', {'dsp-lbl-ar': pin.kind === 'nameplate'}]}
                              id={`dsp-pin-${index}`}
                              dir={pin.kind === 'nameplate' ? 'rtl' : undefined}
                              lang={pin.kind === 'nameplate' ? 'ar' : undefined}>{pin.label}</span>

                        {pin.kind === 'origin' && (
                            <div class='text-center'>
                                {/* The site's own avatar, not an entry asset — so the
                                    entry writes the description and the component owns
                                    the file. Sized down from the 400px original, which
                                    is why the intrinsic box is stated and the drawn
                                    width is not left to the layout. */}
                                <img src='/avatar.png' alt={pin.alt} width='400' height='400' loading='lazy'
                                     class='dsp-bubble block mx-auto mt-1 h-auto w-[172px]'/>
                                <p class='dsp-anno dsp-anno-c mt-3'>{pin.note}</p>
                            </div>
                        )}
                        {pin.kind === 'swatches' && (
                            <>
                                <div class='grid grid-cols-2 gap-2'>
                                    {pin.colors.map((color) => (
                                        <span class='dsp-sw relative block h-14' style={`background:${color.hex}`}>
                                            <i class:list={['absolute', 'bottom-1', 'left-1.5', 'not-italic', 'px-1.5', 'py-0.5',
                                                            {'dsp-sw-light': color.ink === 'light'}]}>{color.name}</i>
                                        </span>
                                    ))}
                                </div>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {pin.kind === 'stat' && (
                            <>
                                <p class='dsp-statn'>{pin.value}</p>
                                <p class='dsp-statc mt-2'>{pin.caption}</p>
                            </>
                        )}
                        {/* Curly marks, not the typewriter pair: the page is a
                            design system showing its own manners. */}
                        {/* The register picks the face, exactly as the mirror's
                            strip says it does: warm speaks in the display serif,
                            sharp in the sans. */}
                        {pin.kind === 'quote' && (
                            <p class:list={['dsp-quote', {'dsp-quote-sharp': pin.register === 'sharp'}]}>“{pin.text}”</p>
                        )}
                        {pin.kind === 'nameplate' && (
                            <div dir='rtl' lang='ar' class='text-right'>
                                <p class='dsp-arname'>{pin.name}</p>
                                <p class='dsp-arbody mt-1.5'>{pin.body}</p>
                            </div>
                        )}
                        {pin.kind === 'faces' && (
                            <>
                                <p class='dsp-proofline mt-0.5'>Aa <span lang='ar'>ع</span></p>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {/* Written with no gaps between the tag and the
                            expression on purpose: inside a pre, any air left
                            around them is drawn. */}
                        {pin.kind === 'terminal' && (
                            <pre class='dsp-term'>{pin.lines.map((line) => (
                                <span>{line.prompt ? '$ ' : ''}{line.text}</span>
                            ))}<span class='dsp-cursor' aria-hidden='true'></span></pre>
                        )}
                        {pin.kind === 'states' && (
                            <>
                                <div class='flex flex-wrap gap-2'>
                                    {pin.items.map((item) => (
                                        <span class={`dsp-st dsp-st-${item.tone} rounded-full px-3 py-1`}>{item.glyph} {item.name}</span>
                                    ))}
                                </div>
                                <p class='dsp-anno mt-3'>{pin.note}</p>
                            </>
                        )}
                        {pin.kind === 'audit' && (
                            <dl class='dsp-audit'>
                                {pin.rows.map((row) => (
                                    <div class='flex justify-between gap-3'><dt>{row.check}</dt><dd>{row.result}</dd></div>
                                ))}
                            </dl>
                        )}

                        {/* data-pin-more carries the pin's own label because
                            Task 8 reports unfolds by which pin was unfolded,
                            and the native toggle event is what it listens on —
                            so nothing here dispatches anything. One catch for
                            that listener: toggle does not bubble, so a document
                            listener only ever hears it in the capture phase. */}
                        {pin.more && (
                            <details class='dsp-more mt-3.5' data-pin-more={pin.label}
                                     dir={pin.more.lang === 'ar' ? 'rtl' : undefined}
                                     lang={pin.more.lang === 'ar' ? 'ar' : undefined}>
                                <summary class:list={['inline-flex', 'items-center', 'gap-1.5',
                                                      {'dsp-more-ar': pin.more.lang === 'ar'}]}>
                                    <span class='dsp-chev' aria-hidden='true'>›</span> {pin.more.label}
                                </summary>
                                <p class:list={['dsp-morebody', 'mt-3', 'pt-3', {'dsp-morebody-ar': pin.more.lang === 'ar'}]}>{pin.more.body}</p>
                            </details>
                        )}
                    </article>
                ))}
            </div>
        </div>
        {/* The closing. One statement, the contract behind it, and a way back
            into the board — the two controls are the only places on the page
            that ask for anything. */}
        {/* id read by section_view, like the mirror's — see the note there. */}
        <section class='border-t border-hairline mt-4' id='closing'>
            <div class='shell py-20 text-center reveal'>
                <h2 class='dsp-closing font-semibold text-strong tracking-[-0.015em] leading-[1.1]'>
                    {closingWash
                        ? <>{closingWash.before}<span class='marker-wash whitespace-nowrap'>{closingWash.washed}</span>{closingWash.after}</>
                        : closing.heading}
                </h2>
                <p class='dsp-closingsub'>{closing.sub}</p>
                <div class='flex gap-3 justify-center items-start flex-wrap'>
                    {/* The summary IS the primary button. No data-pin-more here:
                        the summary already reports as a cta click, and one click
                        must not report as two events.

                        These two attributes do not finish the job, though. A
                        summary raises click when it CLOSES as well as when it
                        opens, so Task 8's cta_click listener has to drop the
                        closing half or a reader who folds the contract back up
                        is counted as having pressed the button twice. The test
                        is cheap: a summary's activation runs after the event has
                        finished propagating, so at listener time details.open
                        still carries the value from BEFORE the click — open
                        means this click is the one closing it. */}
                    <details class='dsp-contract'>
                        <summary class='dsp-btn dsp-btn-pri' data-cta='primary' data-cta-location='closing'>{closing.contract.label}</summary>
                        {/* The prohibitions are the contract's teeth, so the
                            bold belongs to them rather than to the permissions. */}
                        <div class='dsp-contractbody'>
                            <p>{closing.contract.may}</p>
                            <p><strong>{closing.contract.never}</strong></p>
                        </div>
                    </details>
                    {/* A link rather than a button, because #dsp-railboard is a
                        real place on this page and a fragment jump is what
                        still gets a reader there with no script running. The
                        wrapper's scroll-mt-[var(--anchor-offset)] means even
                        that bare jump lands clear of the site's bar.

                        The script upgrades it in place: preventDefault, then
                        the focus, the rail's own click and the motion-aware
                        scroll that the plain jump cannot do. No role is added
                        — a control that takes you to a fragment IS a link, and
                        .dsp-btn is display: inline-block, so an anchor wears it
                        exactly as the button did. */}
                    <a class='dsp-btn dsp-btn-sec' href='#dsp-railboard' data-proofs-stop={closing.proofsStop}
                       data-cta='secondary' data-cta-location='closing'>{closing.proofsLabel}</a>
                </div>
            </div>
        </section>
    </div>

    <style>
        /* Page-scoped additions only. Everything else reads the site's own
           tokens (--cream, --choc, --caramel, --hairline, gradients, grain),
           which global.css already defines. Never import the DS foundation.css
           here: it declares the same names with 1.x values and would rewire the
           shared chrome. */
        .dsp {
            --dsp-font-display: 'Literata', Georgia, serif;
            --dsp-font-sans: 'Readex Pro', system-ui, sans-serif;
            --dsp-font-ar: 'Harmattan', sans-serif;
            --dsp-font-mono: 'JetBrains Mono', monospace;
            --dsp-ease: cubic-bezier(.2, .7, .3, 1);
            --dsp-dur-state: .25s;  /* hover, press, and the pressed states. Reduced motion does not
                                       spare this: global.css clamps every duration on the page to
                                       1ms, so the colour still changes and simply lands at once
                                       instead of over a quarter second. The feedback survives, the
                                       travel does not, which is the right half to keep.
                                       No enter duration is declared beside it because the page has
                                       none of its own — the one-time entrance is the site's .cascade
                                       and .reveal on the site's --dur-slow, and global.css switches
                                       both off under reduced motion rather than clamping them. */
            --dsp-dur-flip: .18s;   /* the dip has to cover the swap, so CSS and the script read one
                                       number. Keep it in seconds: the script multiplies by 1000. */
            /* Caramel as TEXT, which is a different budget from caramel as a
               mark. --accent is 3.1:1 on cream and 3.7:1 on navy — enough for a
               dot, a bar or a fill, and short of the 4.5:1 a 12px control label
               needs. So the marks keep --accent and anything set in the accent
               reads this instead: the same caramel walked toward the page's own
               ink in light, and the brighter caramel the site already carries
               in dark. 4.7:1 and 4.6:1 against the pins they sit on. */
            --dsp-accent-ink: color-mix(in srgb, var(--accent) 72%, var(--choc-ink));
            font-family: var(--dsp-font-sans);
        }
        :global(html.theme-dark) .dsp { --dsp-accent-ink: var(--caramel-bright); }

        /* ---- The masthead ---- */
        /* Two independent bounds, and they answer different questions.

           The clamp floors at 30px because that is the condition washFits is
           measured at — 600 weight, 30px, Georgia as the display fallback,
           -0.015em — so keeping the floor here is what lets the schema's wash
           check hold for this heading with no second metrics table. That bound
           is about ONE un-wrappable phrase against a 320px screen.

           max-width is a measure cap on the WHOLE heading, and is no part of
           the washFit contract: it decides where a long line breaks at desktop
           widths, where the clamp is at its 84px ceiling and nothing is close to
           overflowing. Changing it cannot make a legal wash illegal, and cannot
           rescue an over-long one either. */
        .dsp-display {
            font-family: var(--dsp-font-display);
            font-size: clamp(30px, 8.5vw, 84px);
            max-width: 12ch;
        }
        .dsp-facts { font-family: var(--dsp-font-mono); font-size: 11px; line-height: 1.8; }
        /* One page, one theme control. The pill below is this page's own voice
           for the question, and the header's segmented control says the same
           thing again a few pixels away — so the header's is stood down here,
           and only here. inzsh has no masthead switch and keeps its own.

           Presentation and nothing else: the mechanism is untouched. The
           delegated handler in Header.astro still acts on anything carrying
           .theme-toggle, the pill still rides it, and the hidden control is
           still kept in step by the same aria-pressed sync.

           Conditioned on the page rather than written as a bare :global rule,
           because the two project showcase pages SHARE one stylesheet — both
           link the same _project_ chunk, so an unconditional rule in here would
           hide inzsh's toggle as well. .dsp is this template's root and appears
           on no other page in the build, so :has() asks the one question that
           tells the two apart.

           The child combinator is the other half of the aim. The site's bar is
           a child of body; this page's masthead is a <header> too, further in
           and with the pill inside it, so a plain descendant match would hide
           the very control this rule exists to leave standing. */
        :global(body:has(.dsp) > header .theme-toggle) { display: none; }
        .dsp-modebtn {
            cursor: pointer; border: 1.5px solid var(--text-strong); background: transparent;
            color: var(--text-strong); border-radius: 999px; font-weight: 600; font-size: 13px;
            padding: 9px 20px;
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state), border-color var(--dsp-dur-state);
        }
        /* The label is the page's darkest ink and not --on-accent: see the note
           on .dsp-btn-pri, which is the third control to fill with the accent
           and the place the reasoning is written out. 4.59:1 in both modes. */
        .dsp-modebtn:hover { background: var(--accent); border-color: var(--accent); color: var(--choc-ink); }
        /* The label is a consequence of the theme class, never of the click. */
        :global(html.theme-dark) .dsp-lbl-to-dark,
        :global(html:not(.theme-dark)) .dsp-lbl-to-light { display: none; }

        /* ---- The mirror ---- */
        /* The mirror card. Its split, padding, position and clipping are plain
           layout and ride Tailwind utilities in the markup; what stays here is
           what reads a token, draws state, or has to survive the flip. */
        .dsp-mirror {
            border: 1px solid var(--hairline);
            border-radius: 20px;
            background: color-mix(in srgb, var(--cream) 60%, transparent);
        }
        :global(html.theme-dark) .dsp-mirror { background: color-mix(in srgb, var(--navy-soft) 70%, transparent); }
        /* The flip itself: the card's flow reverses, so the two tracks trade
           places. Each side keeps its own dir, so no sentence is disturbed. */
        .dsp-mirror.is-flipped { direction: rtl; }
        .dsp-mside { transition: opacity var(--dsp-dur-flip) ease, transform var(--dsp-dur-flip) ease; }
        .dsp-mirror.is-swapping .dsp-mside { opacity: 0; transform: scale(.985); }

        /* The seam between the sides. It is drawn on the Arabic column, on
           whichever edge faces the English one, and that edge changes when the
           card flips — so it is stated as a physical edge and swapped by the
           state class. A flow-relative edge cannot say it: it would resolve
           against the Arabic column's own dir, which never changes, rather
           than against the card's flow, which is the thing that flips.

           Stacked, the seam is horizontal instead. The width here has to stay
           in step with the min-[860px]:grid-cols-2 utility on .dsp-mirror. */
        .dsp-mside-ar { border-top: 1px solid var(--hairline); }
        @media (min-width: 860px) {
            .dsp-mside-ar { border-top: 0; border-left: 1px solid var(--hairline); }
            .dsp-mirror.is-flipped .dsp-mside-ar { border-left: 0; border-right: 1px solid var(--hairline); }
        }

        .dsp-mhead {
            font-family: var(--dsp-font-display);
            font-size: clamp(22px, 2.6vw, 30px);
            font-weight: 600;
            line-height: 1.2;
            color: var(--text-strong);
            margin: 0 0 8px;
        }
        .dsp-mbody { font-size: 13.5px; color: var(--text-muted); line-height: 1.65; margin: 0; }
        /* The system's Arabic rules, applied rather than described: a larger
           size, a looser leading, and never any letter spacing. */
        .dsp-mhead-ar { font-family: var(--dsp-font-ar); font-weight: 700; font-size: clamp(26px, 3vw, 36px); line-height: 1.4; }
        .dsp-mbody-ar { font-family: var(--dsp-font-ar); font-size: 16px; line-height: 1.85; }
        .dsp-kicker-ar { font-family: var(--dsp-font-ar); font-size: 13px; letter-spacing: 0; text-transform: none; }

        .dsp-flipbtn {
            cursor: pointer; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3;
            border: 1.5px solid var(--text-strong); background: var(--cream); color: var(--text-strong);
            border-radius: 999px; font-weight: 600; font-size: 12.5px; padding: 8px 16px;
            box-shadow: var(--shadow-card);
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state), transform var(--dsp-dur-state);
        }
        /* Only the ground differs in dark: the border and the label are already
           --text-strong in the base rule, which IS cream once the theme flips,
           and restating them here bought nothing.

           :not(:hover) is the point of this rule, not a flourish. A scoped
           :global(html.theme-dark) selector outweighs a scoped :hover one — an
           extra class and a type selector against a single pseudo-class — so
           written plainly this rule won in dark mode even while the pointer was
           on the button, and the hover below painted nothing at all there. It
           had been that way since the flip was built. Standing the rest state
           down while the pointer is on the button says the intent directly and
           leaves the hover to win on its own. */
        :global(html.theme-dark) .dsp-flipbtn:not(:hover) { background: var(--navy-soft); }
        /* Same accent fill and the same ink as the other two accent fills. */
        .dsp-flipbtn:hover { background: var(--accent); border-color: var(--accent); color: var(--choc-ink); transform: translate(-50%, -50%) scale(1.05); }
        .dsp-flipbtn b { font-family: var(--dsp-font-ar); font-weight: 700; font-size: 15px; }

        /* ---- The story rail ---- */
        /* Pinned under the site's own bar rather than at a bare 20px: the
           header is sticky and 85px tall, so anything that pins itself to the
           top of the window reads --nav-height or ends up drawn beneath it.

           Narrow first. What is written plainly here is the chip row; the
           spine, and the dot per stop that only a spine can carry, are declared
           inside the 900px query rather than switched off outside it. */
        .dsp-rail { top: var(--nav-height); }
        .dsp-railline {
            border: 1px solid var(--hairline);
            border-radius: 999px;
            /* Solid, because pins scroll underneath it. Content showing
               through a sticky control row reads as dirt on the row rather
               than as depth, and the row needs no translucency to feel light:
               a hairline, a pill and a page's worth of air already say it. */
            background: var(--surface);
            padding: 5px;
            /* The row is a pill and a platform scrollbar draws a grey bar
               across the bottom of it. The half-cut chip at the right edge is
               the affordance, and it is the one the design draws. */
            scrollbar-width: none;
        }
        .dsp-railline::-webkit-scrollbar { display: none; }
        .dsp-stop {
            cursor: pointer;
            background: none;
            border: none;
            border-radius: 999px;
            padding: 7px 14px;
            font-family: inherit;
            font-size: 13.5px;
            color: var(--text-muted);
            transition: color var(--dsp-dur-state), background-color var(--dsp-dur-state);
        }
        .dsp-stop:hover { color: var(--text-strong); }
        /* The trade, named exactly: a mouse click leaves the browser's focus
           indicator on the chip it landed on until something else takes focus,
           and a marked chip standing beside the lit one reads as a second
           current stop. Keyboard focus keeps its indicator, which is the half
           that was ever doing any work.

           Longhand, never the shorthand — see the byte-scan note in
           tailwind.config.mjs, and the same care CodeBlock takes. The shorthand
           property name is a utility name, and so is the usual word for the
           indicator itself, which is why neither is written on this page. */
        .dsp-stop:focus:not(:focus-visible) { outline-style: none; }
        /* A wash under the current chip rather than a solid accent fill. A
           filled accent needs an ink dark enough to sit on it — see the note on
           .dsp-btn-pri, where the page's three accent fills settle that — and
           this is a 13.5px label with no fill to sit on; the marker wash puts
           the page's strong ink on caramel at 12:1 in light and 7.8:1 in dark,
           in the same caramel the headings are marked with. */
        .dsp-stop.is-on { color: var(--text-strong); font-weight: 600; background: var(--accent-wash); }
        .dsp-railcap {
            font-family: var(--dsp-font-mono); font-size: 9.5px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--text-muted);
        }
        .dsp-railnote { font-family: var(--dsp-font-mono); font-size: 11.5px; line-height: 1.6; color: var(--text-muted); }

        @media (min-width: 900px) {
            .dsp-rail { top: calc(var(--nav-height) + 20px); }
            .dsp-railline {
                border: 0;
                border-left: 3px solid color-mix(in srgb, var(--accent) 35%, transparent);
                border-radius: 0;
                background: none;
                padding: 0;
            }
            .dsp-stop { padding: 9px 0 9px 20px; border-radius: 0; }
            .dsp-stop.is-on { background: none; }
            /* Preflight makes every box border-box, so the 11px here is the
               whole dot and the 3px band around it eats inward. That is what
               puts the dot's centre on the spine at left: -7px. */
            .dsp-stop::before {
                content: "";
                position: absolute;
                left: -7px;
                top: 13px;
                width: 11px;
                height: 11px;
                border-radius: 50%;
                background: var(--surface);
                border: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
                transition: background-color var(--dsp-dur-state), border-color var(--dsp-dur-state), transform var(--dsp-dur-state);
            }
            .dsp-stop:hover::before { transform: scale(1.15); }
            .dsp-stop.is-on::before { background: var(--accent); border-color: var(--accent); }
        }

        /* ---- The board ---- */
        /* A packed multi-column board: the pins differ in height by design and
           the browser fits them together. Which is also why the rail follows
           the pointer and never the scroll offset — a packed board has no one
           vertical order to read a current stop out of. */
        .dsp-pin {
            background: color-mix(in srgb, var(--cream) 55%, transparent);
            border: 1px solid var(--hairline);
            border-radius: 20px;
            box-shadow: var(--shadow-soft);
            transition: transform .3s var(--dsp-ease), box-shadow .3s var(--dsp-ease), opacity .45s ease, filter .45s ease;
        }
        /* :not() rather than a later override, so the two pins that are navy in
           both modes never enter the argument. */
        :global(html.theme-dark) .dsp-pin:not(.dsp-pin-dark) { background: color-mix(in srgb, var(--navy-soft) 70%, transparent); }
        .dsp-pin:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }
        /* Set back, never taken away: a pin outside the chosen stop keeps its
           place, its text and its tab stop, so the rail is emphasis rather than
           a search. Which is also why reaching one by keyboard restores it —
           .14 is not something a reader can be left stranded in. */
        .dsp-pin.is-dim { opacity: .14; transform: scale(.97); filter: saturate(.35); }
        .dsp-pin.is-dim:focus-within { opacity: 1; transform: none; filter: none; }

        /* ---- The pins ---- */
        .dsp-pindot {
            top: -6px; left: 50%; transform: translateX(-50%);
            width: 12px; height: 12px; border-radius: 50%;
            background: var(--accent); box-shadow: var(--shadow-soft);
            transition: transform var(--dsp-dur-state);
        }
        .dsp-pin:hover .dsp-pindot { transform: translateX(-50%) scale(1.25); }
        .dsp-lbl {
            font-family: var(--dsp-font-mono); font-size: 10px; letter-spacing: .1em;
            text-transform: uppercase; color: var(--text-muted);
        }
        /* The system's Arabic rules again: bigger, and never letter-spaced. */
        .dsp-lbl-ar { font-family: var(--dsp-font-ar); font-size: 13px; letter-spacing: 0; text-transform: none; }

        .dsp-anno {
            font-family: var(--dsp-font-display); font-style: italic; font-size: 14.5px;
            color: var(--text-muted); line-height: 1.55;
        }
        .dsp-anno::before {
            content: ""; display: block; width: 24px; height: 3px;
            background: var(--accent); border-radius: 2px; margin-bottom: 8px;
            transition: width .3s var(--dsp-ease);
        }
        .dsp-pin:hover .dsp-anno::before { width: 44px; }
        .dsp-anno-c { text-align: center; }
        .dsp-anno-c::before { margin-inline: auto; }

        /* The curve is spelled out rather than named: the keyword for it is
           byte-identical to a utility, and Tailwind reads this file as bytes. */
        .dsp-bubble { animation: dsp-float 6.5s cubic-bezier(.42, 0, .58, 1) infinite; }
        @keyframes dsp-float { 50% { transform: translateY(-5px); } }

        .dsp-sw { border: 1px solid var(--hairline); border-radius: 10px; }
        /* The palette is content, so these labels sit on hexes that do not move
           with the theme — and one of them cannot carry a bare label at any
           lightness: cream on caramel reads 3.2:1 and pure white only reaches
           3.7:1. A small ground under the label settles every swatch at once,
           at 8.5:1 or better, and reads as a caption rather than as a repair. */
        .dsp-sw i {
            font-family: var(--dsp-font-mono); font-size: 8.5px; border-radius: 5px;
            color: var(--choc-ink);
            background: color-mix(in srgb, var(--cream-bright) 72%, transparent);
        }
        .dsp-sw i.dsp-sw-light {
            color: var(--cream-soft);
            background: color-mix(in srgb, var(--choc-ink) 62%, transparent);
        }

        .dsp-statn {
            font-family: var(--dsp-font-display); font-size: 76px; font-weight: 600;
            line-height: .95; letter-spacing: -.02em; color: var(--text-strong);
        }
        .dsp-statc { font-size: 12px; line-height: 1.55; color: var(--text-muted); }

        /* Navy in both modes, so everything drawn on it is stated against navy
           rather than against a token that flips underneath it. */
        .dsp-pin-dark { background: var(--navy); border-color: transparent; }
        /* In dark mode the page is that same navy, so these two pins stop being
           cards and become holes. The edge is what says they are still pins —
           and it is drawn rather than the colour changed, because everything
           inside them is written against navy in both modes. */
        :global(html.theme-dark) .dsp-pin-dark { border-color: var(--hairline); }
        .dsp-pin-dark .dsp-lbl { color: var(--cream-muted); }
        .dsp-quote {
            font-family: var(--dsp-font-display); font-style: italic; font-size: 19px;
            line-height: 1.45; color: var(--cream);
        }
        /* Sharp register: the sans face, upright and front-loaded, a step
           smaller because Readex runs wider than Literata at the same size. */
        .dsp-quote-sharp {
            font-family: var(--dsp-font-sans); font-style: normal; font-weight: 700;
            font-size: 17px; letter-spacing: -0.01em;
        }

        .dsp-arname {
            font-family: var(--dsp-font-ar); font-size: 33px; font-weight: 700;
            line-height: 1.45; color: var(--text-strong);
        }
        .dsp-arbody { font-family: var(--dsp-font-ar); font-size: 14.5px; line-height: 1.8; color: var(--text-muted); }
        .dsp-proofline {
            font-family: var(--dsp-font-display); font-size: 64px; font-weight: 600;
            line-height: 1; color: var(--text-strong);
        }
        .dsp-proofline span { font-family: var(--dsp-font-ar); font-weight: 700; }

        /* One step below the pin it sits in, which is what makes it a well
           rather than a rectangle the same colour as its surroundings. */
        .dsp-term {
            background: var(--navy-deep); border-radius: 12px; color: var(--cream-muted);
            font-family: var(--dsp-font-mono); font-size: 11.5px; line-height: 1.7;
            padding: 14px 16px; overflow-x: auto;
        }
        /* A command stays on one line and the well scrolls sideways under it
           instead — which is what a terminal does, and the same call CodeBlock
           and BandPage write out for code: a wrapped command is not a command,
           it is two lines a reader has to reassemble before they can run it.
           Stated on the lines rather than on the well, so the pane can scroll
           while nothing inside it is allowed to fold. */
        .dsp-term span { display: block; white-space: pre; }
        .dsp-term .dsp-cursor {
            display: inline-block; width: 7px; height: 13px; background: var(--cream-muted);
            vertical-align: -2px; animation: dsp-blink 1.15s steps(1) infinite;
        }
        @keyframes dsp-blink { 50% { opacity: 0; } }

        /* Two colours per state and not one: the wash carries the hue and the
           ink carries the reading. Two of the four inks are derived from the
           site's ramp in each mode — walked toward the page's ink in light, and
           the ramp's own bright end in dark — and the other two are authored,
           because the site has no token for a negative or a caution. Every ink
           below is 4.5:1 or better on its own wash, measured in both modes. */
        .dsp-st {
            font-size: 11px; font-weight: 600;
            background: color-mix(in srgb, var(--dsp-st-tone) 16%, transparent);
            color: var(--dsp-st-ink);
        }
        .dsp-st-positive { --dsp-st-tone: var(--sage);     --dsp-st-ink: color-mix(in srgb, var(--sage) 70%, var(--choc-ink)); }
        .dsp-st-info     { --dsp-st-tone: var(--ink-blue); --dsp-st-ink: color-mix(in srgb, var(--ink-blue) 70%, var(--choc-ink)); }
        .dsp-st-negative { --dsp-st-tone: #8E4A42;         --dsp-st-ink: #7A3A33; }
        .dsp-st-caution  { --dsp-st-tone: #B8912F;         --dsp-st-ink: #6B5219; }
        :global(html.theme-dark) .dsp-st-positive { --dsp-st-ink: var(--sage-bright); }
        :global(html.theme-dark) .dsp-st-info     { --dsp-st-ink: var(--ink-blue-bright); }
        :global(html.theme-dark) .dsp-st-negative { --dsp-st-ink: #C98D85; }
        :global(html.theme-dark) .dsp-st-caution  { --dsp-st-ink: #D4B25E; }

        .dsp-audit { font-family: var(--dsp-font-mono); font-size: 12px; line-height: 2.05; }
        /* --positive walked one step toward the page's ink. Sage alone is 4:1
           on a cream pin and 2.9:1 on a navy one; this is 5.3:1 and 6.6:1, and
           still reads as the same green either side. */
        .dsp-audit dd { color: color-mix(in srgb, var(--positive) 78%, var(--text-strong)); }

        .dsp-more summary {
            cursor: pointer; list-style: none;
            font-size: 12.5px; font-weight: 600; color: var(--dsp-accent-ink);
            transition: color var(--dsp-dur-state);
        }
        .dsp-more summary::-webkit-details-marker { display: none; }
        .dsp-more summary:hover { color: var(--text-strong); }
        /* On a navy pin the page's strong ink is chocolate half the time, and
           the light-mode accent ink is a dark caramel. Both are restated. */
        .dsp-pin-dark .dsp-more summary { color: var(--caramel-bright); }
        .dsp-pin-dark .dsp-more summary:hover { color: var(--cream); }
        .dsp-more-ar { font-family: var(--dsp-font-ar); font-size: 15px; }
        /* U+203A is a bidi-mirrored character, so the browser has already
           flipped the closed glyph to point leftward inside dir='rtl'. Nothing
           here has to turn it, and a rule that did would undo the browser's own
           correction. Only the open state needs a direction-aware sign: turning
           a rightward mark a quarter clockwise points it down, and turning a
           leftward one the same way points it up. */
        .dsp-chev { display: inline-block; font-size: 11px; transition: transform var(--dsp-dur-state); }
        .dsp-more[open] .dsp-chev { transform: rotate(90deg); }
        .dsp-more[dir='rtl'][open] .dsp-chev { transform: rotate(-90deg); }
        .dsp-morebody {
            font-size: 12.5px; line-height: 1.65; color: var(--text-muted);
            border-top: 1px solid var(--hairline);
            animation: dsp-unfold .35s var(--dsp-ease);
        }
        .dsp-pin-dark .dsp-morebody {
            color: var(--cream-muted);
            border-top-color: color-mix(in srgb, var(--cream) 18%, transparent);
        }
        @keyframes dsp-unfold { from { opacity: 0; transform: translateY(-4px); } }
        .dsp-morebody-ar { font-family: var(--dsp-font-ar); font-size: 14px; line-height: 1.85; }

        /* ---- The closing ---- */
        /* Half the draw, and only for this heading. global.css wipes a
           .marker-wash over 420ms once the observer marks it, which the
           masthead can afford: it is drawn on load and the reader arrives with
           it, so the slow stroke is the reader watching a mark being made. This
           one is triggered under the fold, so it is FIRST seen mid-stroke, and
           a mark caught half made does not read as a mark being made. It reads
           as one that came out wrong. The masthead keeps the site's own timing. */
        #closing .marker-wash::before { transition-duration: 210ms; }
        .dsp-closing { font-family: var(--dsp-font-display); font-size: clamp(30px, 7vw, 56px); }
        .dsp-closingsub { margin: 14px auto 26px; font-size: 14.5px; color: var(--text-muted); max-width: 48ch; line-height: 1.65; }
        .dsp-btn {
            font-weight: 600; font-size: 14px; border-radius: 999px; padding: 12px 26px;
            cursor: pointer; display: inline-block; list-style: none;
            transition: background-color var(--dsp-dur-state), color var(--dsp-dur-state), border-color var(--dsp-dur-state), transform var(--dsp-dur-state);
        }
        .dsp-btn:active { transform: scale(.97); }
        /* Where this page departs from the site's own chrome, on purpose, and
           the note the other two departures point at. global.css sets
           .btn-primary to --accent under --on-accent, which measures 3.07:1 in
           light and 3.79:1 in dark — the site's 3:1 button treatment, and short
           of the 4.5:1 a 14px label wants. Five pins up, this page publishes an
           audit that says contrast passes in light and in dark. A page cannot
           print that claim and then set its own loudest control below the bar
           the claim is about.

           So the label is the page's darkest ink instead, and one rule covers
           both modes because --accent does not flip: 4.59:1 either side. All
           three of the page's accent fills take that same pair — this button,
           the light switch and the mirror's flip — so the fork is one decision
           applied consistently, not a button that disagrees with its
           neighbours. The site-wide pair is deliberately left alone for now and
           is the planned site-adjustment pass's to reconcile. */
        .dsp-btn-pri { background: var(--accent); border: 1.5px solid var(--accent); color: var(--choc-ink); }
        /* Both buttons hover into the same inversion: the page's ink becomes
           the ground and the page's ground becomes the ink, which is one rule
           for both modes because both halves flip together. 14.1:1 in light and
           13.6:1 in dark, for each of them.

           The primary needs its own label here rather than inheriting the rest
           state's: the hover ground IS --text-strong, and in light that is the
           same chocolate as the ink above, which would leave 1:1. Naming
           --cream instead would read in light and paint cream on cream in dark,
           at 1:1 the other way round. Only the ground token says it once. */
        .dsp-btn-pri:hover { background: var(--text-strong); border-color: var(--text-strong); color: var(--surface); }
        .dsp-btn-sec { background: transparent; border: 1.5px solid var(--text-strong); color: var(--text-strong); }
        .dsp-btn-sec:hover { background: var(--text-strong); color: var(--surface); }
        /* Open rests where hover points, so the control admits it is holding
           the panel. Same three values as the hover above, which cannot fight
           it while both apply. */
        .dsp-contract[open] .dsp-btn-pri {
            background: var(--text-strong); border-color: var(--text-strong); color: var(--surface);
        }
        .dsp-contract summary::-webkit-details-marker { display: none; }
        /* The panel and its summary are one element, so they cannot sit beside
           the proofs button and underneath it at the same time. Open, the
           disclosure takes the row for itself and centres its own summary, and
           the proofs button wraps below the panel — which is the order the copy
           wants anyway: open the contract, read it, then be offered the proofs.
           Closed, the two controls are a centred pair at every width.

           This leans on the flex-wrap utility on the row and does not work
           without it. A basis of 100% only pushes the proofs button onto a line
           of its own if the row is allowed to make one; on a row that cannot
           wrap, the two controls stay put and share the width, and the open
           panel is squeezed into whatever is left of it.

           display: contents on the disclosure looks like the shortcut here,
           because it would drop summary and panel straight into the row and let
           each take its own line. Do not reach for it: the box it removes is
           the one current engines hang the closed panel's hiding off, so the
           contract would be on show before anyone asked for it. */
        .dsp-contract[open] { flex-basis: 100%; text-align: center; }
        .dsp-contractbody {
            max-width: 640px; margin: 20px auto 0; text-align: start;
            font-size: 13px; line-height: 1.65; color: var(--text-muted);
            border-top: 1px solid var(--hairline); padding-top: 16px;
            animation: dsp-unfold .35s var(--dsp-ease);
        }
        .dsp-contractbody p { margin: 0 0 10px; }
        .dsp-contractbody strong { color: var(--text-body); }

        /* global.css caps every animation and transition at 1ms under reduced
           motion, which finishes a one-shot and makes an endless one flicker
           instead of stopping. The two endless ones on this page are named off
           here, the same escape hatch .marquee-track takes.

           The rest of the page's motion, audited against that clamp:
           dsp-unfold on both disclosure panels is a one-shot and the clamp
           lands it at its end state; the pin lift, the pin dim, the pindot and
           spine-dot scales, the annotation rule's stretch and the chevron's
           quarter turn are all state, so the clamp keeps the state and drops
           the travel; the flip button's hover swell and the buttons' press dip
           are the same clamped category; the mirror's dip is not clamped but
           skipped, the script branching on the same query and flipping with no
           fade at all; and the proofs scroll asks for 'instant' rather than
           letting html's smooth scroll-behavior answer. Nothing here travels
           under reduced motion. */
        @media (prefers-reduced-motion: reduce) {
            .dsp-bubble, .dsp-term .dsp-cursor { animation: none; }
        }
    </style>

    <script>
        const bindMirror = () => {
            const mirror = document.getElementById('dsp-mirror');
            const btn = document.querySelector<HTMLButtonElement>('[data-mirror-flip]');
            if (!mirror || !btn || btn.dataset.bound) return;
            // Per-element rather than per-window: View Transitions swap in a new
            // button on every navigation back to this page, so the flag has to
            // live on the element that carries the listener. The document
            // listener below is registered once, when this module first runs.
            btn.dataset.bound = '1';
            const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            // Read once, from the same custom property the fade is written in, so
            // the wait can never drift from the animation it is waiting on.
            const dip = parseFloat(getComputedStyle(mirror).getPropertyValue('--dsp-dur-flip')) * 1000 || 180;
            btn.addEventListener('click', () => {
                // A dip already in flight owns the card. Without this, a fast
                // second click flips the columns while they are still faded out
                // and the reader sees them strobe.
                if (mirror.classList.contains('is-swapping')) return;
                const flip = () => {
                    mirror.classList.toggle('is-flipped');
                    const flipped = mirror.classList.contains('is-flipped');
                    btn.setAttribute('aria-pressed', String(flipped));
                    // Task 8's analytics listens for pinboard:flip. Emitted here
                    // rather than measured there so the reading direction the
                    // event reports is the one the card actually settled on.
                    document.dispatchEvent(new CustomEvent('pinboard:flip', {
                        detail: {to: flipped ? 'to-ar' : 'to-en'}
                    }));
                };
                if (reduced()) { flip(); return; }
                mirror.classList.add('is-swapping');
                setTimeout(() => {
                    // A navigation mid-dip detaches this card. Firing anyway would
                    // announce a flip on whatever page the reader is on instead.
                    if (!mirror.isConnected) return;
                    flip();
                    mirror.classList.remove('is-swapping');
                }, dip);
            });
        };

        // Set by bindProofs for the length of one synthetic click, read and
        // cleared by the rail's own handler. Task 8 wants to tell a stop the
        // reader chose in the rail apart from the same stop arrived at through
        // the closing band, and the click itself carries nothing to say which:
        // a synthetic click is indistinguishable from a real one by design.
        // Module scope rather than a data attribute so nothing about it is
        // visible in the DOM, and the two writes are one synchronous step apart.
        let viaProofs = false;

        const bindRail = () => {
            const board = document.getElementById('dsp-board');
            if (!board || board.dataset.bound) return;
            board.dataset.bound = '1';
            const railStops = [...document.querySelectorAll<HTMLButtonElement>('[data-rail-stop]')];
            const pinEls = [...board.querySelectorAll<HTMLElement>('[data-pin-stop]')];
            let filtering = 'all';

            // The pressed state goes with the highlight rather than being set
            // only on click: these buttons are an exclusive group, so whichever
            // one the rail is currently showing as current is the one a screen
            // reader should hear as pressed.
            const light = (id: string) => railStops.forEach((stop) => {
                const on = stop.dataset.railStop === id;
                stop.classList.toggle('is-on', on);
                stop.setAttribute('aria-pressed', String(on));
            });

            railStops.forEach((stop) => stop.addEventListener('click', () => {
                filtering = stop.dataset.railStop ?? 'all';
                // Read and cleared on every click, including the ones that do
                // not report, so a flag can never outlive the click it was set
                // for and colour the next one.
                const via = viaProofs ? 'proofs' : 'rail';
                viaProofs = false;
                light(filtering);
                pinEls.forEach((pinEl) => {
                    pinEl.classList.toggle('is-dim', filtering !== 'all' && pinEl.dataset.pinStop !== filtering);
                });
                if (filtering !== 'all') {
                    // Task 8's analytics listens for pinboard:focus. Only a real
                    // narrowing is reported: going back to all pins is leaving a
                    // stop rather than choosing one.
                    document.dispatchEvent(new CustomEvent('pinboard:focus', {detail: {stop: filtering, via}}));
                }
            }));

            // Hover and keyboard focus drive the rail, never scroll: a packed
            // board has no single vertical order, so scroll offset lies.
            const track = (pinEl: HTMLElement) => {
                // A chosen stop owns the rail until another one is chosen.
                if (filtering !== 'all') return;
                light(pinEl.dataset.pinStop ?? 'all');
            };
            pinEls.forEach((pinEl) => {
                pinEl.addEventListener('mouseenter', () => track(pinEl));
                pinEl.addEventListener('focusin', () => track(pinEl));
            });
            board.addEventListener('mouseleave', () => { if (filtering === 'all') light('all'); });
        };

        const bindProofs = () => {
            const link = document.querySelector<HTMLAnchorElement>('[data-proofs-stop]');
            if (!link || link.dataset.bound) return;
            link.dataset.bound = '1';
            link.addEventListener('click', (event) => {
                // The href is what the page does with no script; this handler is
                // the upgrade and takes the click over completely. Left to run,
                // the browser's own jump would land first and fight the scroll
                // below, and put #dsp-railboard in the address bar on the way.
                event.preventDefault();
                // Read once and shared by both scrolls below. 'instant' rather
                // than 'auto': 'auto' does not mean "no animation", it means "go
                // and ask the computed styles", and global.css sets
                // scroll-behavior: smooth on html.
                const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
                // Reuse the rail: a synthetic click gets the dim, the is-on state
                // and the analytics event from one mechanism instead of three.
                // The rail stops carry no data-cta, so the cta_click listener
                // never sees the synthetic click and this control's own click is
                // still counted exactly once.
                const stop = document.querySelector<HTMLButtonElement>(`[data-rail-stop="${link.dataset.proofsStop}"]`);
                if (stop) {
                    // The page moves, so the keyboard moves with it: focus lands
                    // on the stop this button just chose, and the next Tab
                    // carries on into the board instead of resuming down here in
                    // the closing band, a screen away from what the reader was
                    // sent to look at. preventScroll because the scroll below is
                    // the considered one — focus would otherwise jump first, with
                    // none of the clearance and none of the motion setting.
                    // Nothing listens for focus on a rail stop, so this moves the
                    // caret and nothing else.
                    stop.focus({preventScroll: true});
                    // Only ever true across the click on the next line.
                    viaProofs = true;
                    stop.click();
                    // Under 900px the rail is a row that scrolls sideways, and
                    // the chosen chip can sit outside its window — focused,
                    // lit, and off the side of the screen. inline: 'center'
                    // brings it in; block: 'nearest' asks the page for the
                    // least vertical movement it can, and the scroll below then
                    // supersedes that on the same box rather than fighting it,
                    // because a second scroll aborts the first. Above 900px the
                    // row has no overflow to scroll and this does nothing.
                    stop.scrollIntoView({block: 'nearest', inline: 'center', behavior});
                }
                document.getElementById('dsp-railboard')?.scrollIntoView({behavior, block: 'start'});
            });
        };

        // One listener for the page, fanning out to the sections. Each part
        // carries its own guard, so a section already wired after a View
        // Transitions swap is skipped without skipping the others. bindRail's
        // guard is the board rather than the rail it also wires: the two arrive
        // and are replaced together, so the board standing guard for the pair
        // is one flag on one element instead of two that could disagree.
        const bindPinboard = () => { bindMirror(); bindRail(); bindProofs(); };
        document.addEventListener('astro:page-load', bindPinboard);
    </script>

    <ProjectAnalytics/>
</BaseLayout>
