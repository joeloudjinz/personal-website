---
import {EMAIL, LINKEDIN_ACCOUNT} from '../consts';

interface Props {
    variant?: 'centered' | 'row';
}

const {variant = 'centered'} = Astro.props;
---

{variant === 'centered' ? (
        <section class='shell py-[88px] text-center reveal'>
            <h2 class='font-display text-4xl md:text-[56px] font-semibold text-strong tracking-[-0.015em] leading-tight mb-6'>
                I'm one <span class='marker-wash'>message</span> away.
            </h2>
            <p class='text-lg text-muted mb-9 max-w-[520px] mx-auto'>
                Reach out on LinkedIn, or send a direct email. I'll be delighted to answer.
            </p>
            <div class='flex justify-center flex-wrap gap-4'>
                <a href={`mailto:${EMAIL}`} class='btn btn-primary btn-lg' rel='nofollow noopener'>Email me</a>
                <a href={LINKEDIN_ACCOUNT} class='btn btn-secondary btn-lg' target='_blank'>LinkedIn</a>
            </div>
        </section>
) : (
        <section class='shell py-[72px] reveal'>
            <div class='flex flex-col md:flex-row md:items-center justify-between gap-8'>
                <div>
                    <h2 class='font-display text-[34px] font-semibold text-strong mb-3'>
                        I'm one <span class='marker-wash'>message</span> away.
                    </h2>
                    <p class='text-base text-muted'>
                        Reach out on LinkedIn, or send a direct email. I'll be delighted to answer.
                    </p>
                </div>
                <div class='flex flex-wrap gap-4 shrink-0'>
                    <a href={`mailto:${EMAIL}`} class='btn btn-primary' rel='nofollow noopener'>Email me</a>
                    <a href={LINKEDIN_ACCOUNT} class='btn btn-secondary' target='_blank'>LinkedIn</a>
                </div>
            </div>
        </section>
)}
