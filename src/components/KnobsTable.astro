---
// A configuration reference table: one row per knob, its accepted values, its
// default and what it does. The surface treatment is the post-detail comparison
// table's — card, radius 14, --shadow-soft, internal hairline grid — so a reader
// arriving from an article recognises it.
//
// Column headers are data, never constants: "fallback" prints as "Default" for
// this project and as something else for the next one.

interface Props {
    /**
     * The four column headings, as authored.
     *
     * Structural, like DefinitionRows' rows, rather than aliased to the config
     * band's type. This is a configuration table, not that band's table — naming
     * one band's key here would make the component's type break the day the band
     * is renamed, for a component that never mentions the band anywhere else.
     * The call site still fails to typecheck if the schema's shape changes.
     */
    headers: {name: string; values: string; fallback: string; effect: string};
    knobs: {name: string; values: string[]; fallback: string; effect: string}[];
    class?: string;
}

const {headers, knobs, class: className} = Astro.props;

// Paired here rather than in the template so the cell order and the header order
// cannot drift apart, and so the stacked layout's per-cell label is the same
// string as the column heading it stands in for.
const columns = [headers.name, headers.values, headers.fallback, headers.effect];
---

{/* The ARIA roles are redundant while this is laid out as a table and load-bearing
    once it is not: below 1100px the rows restack, and `display: block` on a table
    element drops the implicit table semantics in every major browser. Stated
    explicitly, the header/cell association survives the restack. */}
<table class:list={['knobs cardx', className]} role='table'>
    <colgroup>
        <col class='col-name'/>
        <col class='col-values'/>
        <col class='col-fallback'/>
        <col/>
    </colgroup>
    <thead role='rowgroup'>
        <tr role='row'>
            {columns.map((heading) => <th scope='col' role='columnheader' class='micro-label'>{heading}</th>)}
        </tr>
    </thead>
    <tbody role='rowgroup'>
        {knobs.map((knob) => (
                <tr role='row'>
                    <td role='cell'>
                        <span class='cell-label micro-label' aria-hidden='true'>{headers.name}</span>
                        <span class='knob-name'>{knob.name}</span>
                    </td>
                    <td role='cell'>
                        <span class='cell-label micro-label' aria-hidden='true'>{headers.values}</span>
                        {/* Flex, not inline spans with margins: a middle dot painted by
                            ::before on the following value has no break opportunity around
                            it, so an inline run would refuse to wrap and overflow the cell.
                            This is the .stack-line technique — the dot rides at the START
                            of each value after the first, so it can never wrap onto a line
                            by itself. */}
                        <span class='knob-values'>
                            {knob.values.map((value) => <span class='knob-value'>{value}</span>)}
                        </span>
                    </td>
                    <td role='cell'>
                        <span class='cell-label micro-label' aria-hidden='true'>{headers.fallback}</span>
                        <span class='knob-fallback'>{knob.fallback}</span>
                    </td>
                    <td role='cell'>
                        <span class='cell-label micro-label' aria-hidden='true'>{headers.effect}</span>
                        <span class='knob-effect'>{knob.effect}</span>
                    </td>
                </tr>
        ))}
    </tbody>
</table>

<style>
    /* Written narrow-first. The four fixed columns are what overflowed the
       scaffolding table — 250 + 210 + 90 plus gaps and padding is 670px before
       the effect column gets a single pixel, measured 163px past the viewport at
       375px — so the stack is the base case and the table is the enhancement.
       Layered the other way round, every stacked rule has to out-specify a
       :first-child or :not(:last-child) it is undoing, and the ones that miss
       leave an orphan column rule down the side of a phone. */
    .knobs {
        display: block;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .knobs tbody,
    .knobs tr,
    .knobs th,
    .knobs td {
        display: block;
    }

    /* Column definitions have no meaning while the rows are stacked, and a
       column box outside a table gets an anonymous wrapper. */
    .knobs colgroup { display: none; }

    /* Visually gone, still in the accessibility tree: the roles in the markup
       pair these headers with their cells, so they must not be display:none. */
    .knobs thead {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    .knobs tr {
        padding: 14px 24px;
        border-bottom: 1px solid var(--hairline);
    }

    .knobs tbody tr:last-child { border-bottom: 0; }

    .knobs td {
        padding: 0;
        border: 0;
        text-align: left;
    }

    .knobs td + td { margin-top: 10px; }

    /* Type comes from .micro-label in global.css, which both this and the stacked
       label below carry in the markup. Only the delta lives here. */
    .knobs th {
        text-align: left;
    }

    /* The stacked layout's per-column label — the label above its value rather
       than beside it, because a side-by-side pair leaves too little room for a
       21-character knob name at 320px. aria-hidden in the markup, because the
       real <th> is what a screen reader should hear. */
    .cell-label {
        display: block;
        margin-bottom: 4px;
    }

    .knob-name,
    .knob-values,
    .knob-fallback {
        font-family: var(--font-mono);
        font-size: 13.5px;
    }

    .knob-name {
        font-weight: 600;
        color: var(--text-strong);
        /* Knob names are single unbroken identifiers and the narrow layout has no
           column to spill into. */
        overflow-wrap: anywhere;
    }

    .knob-values {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 7px;
        color: var(--text-body);
    }

    .knob-value + .knob-value::before {
        content: '\00b7';
        color: var(--accent);
        margin-right: 7px;
    }

    .knob-fallback { color: var(--text-muted); }

    .knob-effect {
        font-size: 14px;
        line-height: 1.55;
        color: var(--text-muted);
    }

    /* 1100px is where .shell reaches its 96px padding and the four columns fit
       with room left for the effect text. */
    @media (min-width: 1100px) {
        .knobs {
            display: table;
            table-layout: fixed;
        }

        .knobs colgroup { display: table-column-group; }

        .knobs thead {
            position: static;
            display: table-header-group;
            width: auto;
            height: auto;
            margin: 0;
            overflow: visible;
            clip-path: none;
            white-space: normal;
        }

        .knobs tbody { display: table-row-group; }

        .knobs tr {
            display: table-row;
            padding: 0;
            border-bottom: 0;
        }

        .col-name { width: 250px; }
        .col-values { width: 210px; }
        .col-fallback { width: 90px; }

        /* 12px either side of the internal rules makes the 24px gap the design
           asks for; the outer edges carry the row's own 24px. */
        .knobs th,
        .knobs td {
            display: table-cell;
            vertical-align: baseline;
            padding: 14px 12px;
            border-bottom: 1px solid var(--hairline);
            margin-top: 0;
        }

        .knobs th:first-child,
        .knobs td:first-child { padding-left: 24px; }

        .knobs th:last-child,
        .knobs td:last-child { padding-right: 24px; }

        .knobs th:not(:last-child),
        .knobs td:not(:last-child) { border-right: 1px solid var(--hairline); }

        .knobs tbody tr:last-child td { border-bottom: 0; }

        .cell-label { display: none; }
    }
</style>
