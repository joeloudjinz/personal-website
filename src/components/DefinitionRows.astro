---
// A run of label/value rows: a fixed label column, a fluid value column, a
// hairline between each. Three bands of a project page are shaped this way —
// the deep dive's notes, the specs list, the verification list — so the
// component is the pattern, not any one of them.
//
// A row's value is a whole sentence often enough that it is one of the places
// the entry marks a command or a variable name, so the value goes through
// CodeSpans. The label does not: it is set in the 11px small-caps micro-label
// treatment, where a monospace run would read as a broken letterspacing rather
// than as code, and a label is a heading for the row, not a place to type in.
import CodeSpans from '@src/components/CodeSpans.astro';

interface Props {
    /**
     * Structurally the projectPages schema's labelled row. Written out rather
     * than aliased to one band's type, because no band owns this pattern; the
     * call sites still fail to typecheck if the schema's shape changes.
     */
    items: {label: string; value: string}[];
    class?: string;
}

const {items, class: className} = Astro.props;
---

<dl class:list={['def-rows', className]}>
    {items.map((item) => (
            <div class='def-row'>
                <dt class='def-label micro-label'>{item.label}</dt>
                <dd class='def-value'><CodeSpans text={item.value}/></dd>
            </div>
    ))}
</dl>

<style>
    /* Written narrow-first, like the knobs table and like every other media query
       in src/, which are all min-width. A single max-width rule mixed in among
       them leaves an untested band at fractional widths — browser zoom and
       high-DPI scaling both land the viewport on 767.5px, which satisfies
       neither `max-width: 767px` nor `min-width: 768px`. */
    .def-row {
        display: grid;
        gap: 6px;
        padding: 16px 0;
    }

    /* Between rows only: the band above supplies its own edge, so a rule on the
       first row would double up with it. */
    .def-row + .def-row {
        border-top: 1px solid var(--hairline);
    }

    /* .micro-label in the markup carries the shared treatment; the handoff asks
       for this row's label in caramel rather than the muted default, and that
       one declaration is the whole difference. */
    .def-label {
        color: var(--accent);
    }

    /* .def-value itself lives in global.css beside .micro-label, and for the same
       reason: the configuration band's closing note draws the identical treatment
       without being a row. Nothing about it is scoped to this component.

       A 200px label column leaves too little measure for a paragraph-length value
       on a phone, so the label only moves beside its value once there is room —
       768px, the same breakpoint .shell steps its padding at. */
    @media (min-width: 768px) {
        .def-row {
            grid-template-columns: 200px 1fr;
            gap: 24px;
            align-items: baseline;
        }
    }
</style>
