---
// The heading column of a split band: a kicker, the band's H2, an optional
// standfirst and an optional forward link. why, steps, specs, verification and
// the FAQ are all exactly this, and were five copies of it.
//
// The vertical rhythm is the reason to have the component as much as the markup
// is. The five copies had drifted into three idioms for the same two gaps —
// bottom margins on the elements above (mb-5, mb-7), top margins on the elements
// below (mt-5, mt-7), and one band with a bare mt-5 — with the result that the
// gap above a link depended on which idiom its band happened to be written in
// rather than on anything about the band. specs, written with bottom margins,
// put 20px above its link; the FAQ, written with top margins, put 28px above the
// same thing in the same position.
//
// Settled here as: space belongs to the element below it, and there are two
// gaps. 20px under the kicker and under the heading, because a standfirst
// continues the sentence the heading started. 28px above the link, because a
// link is a separate affordance rather than the next line of the paragraph.
// Top margins throughout, so an absent standfirst leaves nothing behind it
// without a second rule saying so.
import ArrowLink from '@src/components/ArrowLink.astro';
import {bandHeading} from '@src/utils/bandStyles';

interface Props {
    kicker: string;
    heading: string;
    /**
     * The muted sidebar register, not reading copy: this column sits beside the
     * band's content rather than in it. The bands that set an intro across the
     * full width use readingCopy at their own call site instead.
     */
    intro?: string;
    link?: {label: string; href: string};
    /** Placement only — whether the column pins, and where it sits. */
    class?: string;
}

const {kicker, heading, intro, link, class: className} = Astro.props;
---

<div class:list={[className]}>
    <p class='kicker'>{kicker}</p>
    <h2 class:list={[bandHeading, 'mt-4']}>{heading}</h2>
    {intro && <p class='mt-5 text-base text-muted leading-relaxed'>{intro}</p>}
    {link && <ArrowLink href={link.href} label={link.label} class='mt-7'/>}
</div>
