---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import {ClientRouter} from 'astro:transitions';

interface PageProps {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	tags?: string[];
	gradient?: 'glow' | 'subtle' | 'warm';
	/**
	 * Absolute URL this page is authoritative at. Only pages served from a host
	 * other than Astro.site need it — see BaseHead.
	 */
	canonical?: string;
}

/**
 * Which header/footer pair frames the page. 'subdomain' drops the main-site nav
 * for chrome that names the project and points back home.
 *
 * A union so the fields that only mean something to one variant cannot be set on
 * the other: projectName is required by the subdomain chrome and meaningless to
 * the site chrome, and a credit line has nowhere to render on a site page. Both
 * would otherwise be silently ignored.
 */
type ChromeProps =
	| {chrome?: 'site'; projectName?: never; credit?: never}
	| {chrome: 'subdomain'; projectName: string; credit?: string};

type Props = PageProps & ChromeProps;

const GTAG_MEASUREMENT_ID = import.meta.env.PUBLIC_GTAG_MEASUREMENT_ID;
const {
	title, description, image, type, publishedTime, modifiedTime, tags, gradient = 'glow',
	canonical
} = Astro.props;

// Narrowed off Astro.props rather than destructured: pulling chrome and
// projectName into separate consts throws away the correlation the union
// encodes, and Header would no longer typecheck at the call site.
const chrome = Astro.props.chrome === 'subdomain'
	? {variant: 'subdomain', projectName: Astro.props.projectName} as const
	: {variant: 'site'} as const;
const credit = Astro.props.chrome === 'subdomain' ? Astro.props.credit : undefined;
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={title} description={description} image={image} type={type}
				  publishedTime={publishedTime} modifiedTime={modifiedTime} tags={tags}
				  canonical={canonical} />
		<ClientRouter />
		<script is:inline>
			// Runs before paint to avoid a light-mode flash; localStorage wins over OS preference.
			const applyTheme = () => {
				const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
				const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.classList.toggle('theme-dark', theme === 'dark');
				window.localStorage.setItem('theme', theme);
			};
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
	<body class={`page-grad-${gradient} min-h-screen flex flex-col`}>
		<div class='grain-overlay' aria-hidden='true'></div>
		<Header {...chrome}/>
		<main class='flex-1'>
			<slot />
		</main>
		<Footer variant={chrome.variant} credit={credit} />
		{GTAG_MEASUREMENT_ID && (
			<Fragment>
				<!-- Google tag (gtag.js) -->
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_MEASUREMENT_ID}`}></script>
				<script define:vars={{ GTAG_MEASUREMENT_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', GTAG_MEASUREMENT_ID);
				</script>
            </Fragment>
			)}
		<script is:inline>
			if (!window.__revealObserverBound) {
				window.__revealObserverBound = true;
				const initReveals = () => {
					const els = document.querySelectorAll('.reveal:not(.is-visible), .marker-wash:not(.is-visible)');
					if (!('IntersectionObserver' in window)) {
						els.forEach((el) => el.classList.add('is-visible'));
						return;
					}
					const io = new IntersectionObserver((entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					}, {threshold: .12});
					els.forEach((el) => io.observe(el));
				};
				document.addEventListener('astro:page-load', initReveals);
			}
		</script>
	</body>
</html>
